<Window x:Class="Acapella.App.VideoSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Video settings" Height="640" Width="460" MinHeight="360" MinWidth="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="Layout" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>

                <TextBlock Text="Shape" Margin="0,0,0,4"/>
                <ComboBox x:Name="AspectRatioCombo" Margin="0,0,0,12"/>

                <TextBlock Text="When a video doesn't match its cell" Margin="0,0,0,4"/>
                <RadioButton x:Name="FillRadio" Content="Fill the cell (crop the edges)" GroupName="Fit" Margin="0,0,0,2"/>
                <RadioButton x:Name="FitRadio" Content="Fit inside the cell (black bars)" GroupName="Fit" Margin="0,0,0,12"/>

                <DockPanel Margin="0,0,0,4">
                    <TextBlock x:Name="GutterValueText" DockPanel.Dock="Right" Width="48" TextAlignment="Right"/>
                    <TextBlock Text="Gap between cells"/>
                </DockPanel>
                <Slider x:Name="GutterSlider" Minimum="0" Maximum="5" ValueChanged="GutterSlider_ValueChanged" Margin="0,0,0,18"/>

                <TextBlock Text="Background" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                <TextBlock Text="Shows in the gaps and in empty cells." Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6"/>
                <DockPanel Margin="0,0,0,8">
                    <Border x:Name="BackgroundSwatch" DockPanel.Dock="Right" Width="28" Height="22" Margin="8,0,0,0"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                    <TextBox x:Name="BackgroundColorBox" TextChanged="ColorBox_TextChanged" ToolTip="Color as #RRGGBB"/>
                </DockPanel>
                <DockPanel Margin="0,0,0,4">
                    <Button x:Name="ClearImageButton" DockPanel.Dock="Right" Content="Clear" Click="ClearImageButton_Click" Margin="6,0,0,0" Padding="8,2"/>
                    <Button x:Name="BrowseImageButton" DockPanel.Dock="Right" Content="Browse..." Click="BrowseImageButton_Click" Margin="6,0,0,0" Padding="8,2"/>
                    <TextBox x:Name="BackgroundImageBox" IsReadOnly="True"/>
                </DockPanel>
                <ComboBox x:Name="ImageModeCombo" Margin="0,0,0,18"/>

                <TextBlock Text="Watermark" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                <CheckBox x:Name="WatermarkEnabledCheck" Content="Show a watermark on the video" Margin="0,0,0,8"/>
                <TextBlock Text="Text" Margin="0,0,0,4"/>
                <TextBox x:Name="WatermarkTextBox" Margin="0,0,0,8"/>
                <TextBlock Text="Font" Margin="0,0,0,4"/>
                <ComboBox x:Name="FontCombo" Margin="0,0,0,8"/>

                <DockPanel Margin="0,0,0,4">
                    <TextBlock x:Name="SizeValueText" DockPanel.Dock="Right" Width="48" TextAlignment="Right"/>
                    <TextBlock Text="Size"/>
                </DockPanel>
                <Slider x:Name="SizeSlider" Minimum="2" Maximum="20" ValueChanged="SizeSlider_ValueChanged" Margin="0,0,0,8"/>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Text color" Margin="0,0,0,4"/>
                        <DockPanel>
                            <Border x:Name="FillSwatch" DockPanel.Dock="Right" Width="28" Height="22" Margin="8,0,0,0"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                            <TextBox x:Name="FillColorBox" TextChanged="ColorBox_TextChanged"/>
                        </DockPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Outline color" Margin="0,0,0,4"/>
                        <DockPanel>
                            <Border x:Name="StrokeSwatch" DockPanel.Dock="Right" Width="28" Height="22" Margin="8,0,0,0"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                            <TextBox x:Name="StrokeColorBox" TextChanged="ColorBox_TextChanged"/>
                        </DockPanel>
                    </StackPanel>
                </Grid>

                <DockPanel Margin="0,0,0,4">
                    <TextBlock x:Name="StrokeValueText" DockPanel.Dock="Right" Width="48" TextAlignment="Right"/>
                    <TextBlock Text="Outline width"/>
                </DockPanel>
                <Slider x:Name="StrokeSlider" Minimum="0" Maximum="30" ValueChanged="StrokeSlider_ValueChanged" Margin="0,0,0,8"/>

                <DockPanel Margin="0,0,0,4">
                    <TextBlock x:Name="OpacityValueText" DockPanel.Dock="Right" Width="48" TextAlignment="Right"/>
                    <TextBlock Text="Opacity"/>
                </DockPanel>
                <Slider x:Name="OpacitySlider" Minimum="0" Maximum="100" ValueChanged="OpacitySlider_ValueChanged" Margin="0,0,0,8"/>

                <CheckBox x:Name="ShadowCheck" Content="Drop shadow" Margin="0,0,0,8"/>
                <TextBlock Text="Position" Margin="0,0,0,4"/>
                <ComboBox x:Name="CornerCombo" Margin="0,0,0,8"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" IsDefault="True" Width="80" Margin="0,0,8,0" Click="OkButton_Click"/>
            <Button Content="Cancel" IsCancel="True" Width="80"/>
        </StackPanel>
    </Grid>
</Window>
