<Window x:Class="Acapella.App.VideoSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Video settings" SizeToContent="Height" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock Text="Video settings" FontWeight="Bold" FontSize="16" Margin="0,0,0,12"/>

        <TextBlock Text="Shape" Margin="0,0,0,4"/>
        <ComboBox x:Name="AspectRatioCombo" Margin="0,0,0,12"/>

        <TextBlock Text="When a video doesn't match its cell" Margin="0,0,0,4"/>
        <RadioButton x:Name="FillRadio" Content="Fill the cell (crop the edges)" GroupName="Fit" Margin="0,0,0,2"/>
        <RadioButton x:Name="FitRadio" Content="Fit inside the cell (black bars)" GroupName="Fit" Margin="0,0,0,12"/>

        <DockPanel Margin="0,0,0,4">
            <TextBlock x:Name="GutterValueText" DockPanel.Dock="Right" Width="40" TextAlignment="Right"/>
            <TextBlock Text="Gap between cells"/>
        </DockPanel>
        <Slider x:Name="GutterSlider" Minimum="0" Maximum="5" TickFrequency="1" IsSnapToTickEnabled="False"
                ValueChanged="GutterSlider_ValueChanged" Margin="0,0,0,16"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" IsDefault="True" Width="80" Margin="0,0,8,0" Click="OkButton_Click"/>
            <Button Content="Cancel" IsCancel="True" Width="80"/>
        </StackPanel>
    </StackPanel>
</Window>
