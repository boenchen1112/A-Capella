<Window x:Class="Acapella.App.RecordSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Recording setup" Height="360" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Closing="Window_Closing">
    <StackPanel Margin="16">
        <TextBlock Text="Recording setup" FontWeight="Bold" FontSize="16" Margin="0,0,0,12"/>

        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Camera:" VerticalAlignment="Center" Margin="0,4"/>
            <ComboBox Grid.Row="0" Grid.Column="1" x:Name="CameraCombo" Margin="8,4"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Microphone:" VerticalAlignment="Center" Margin="0,4"/>
            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="MicCombo" Margin="8,4"/>
        </Grid>

        <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
            <Button x:Name="CalibrateButton" Content="Calibrate Latency" Click="CalibrateButton_Click" HorizontalAlignment="Left"/>
            <TextBlock x:Name="CalibrationResultText" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{StaticResource MutedTextBrush}"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,12,0,4">
            <CheckBox x:Name="MetronomeToggle" Content="Metronome" VerticalAlignment="Center" Checked="MetronomeToggle_Changed" Unchecked="MetronomeToggle_Changed"/>
            <TextBlock Text="BPM:" Margin="16,0,4,0" VerticalAlignment="Center"/>
            <TextBox x:Name="BpmTextBox" Width="50" Text="120" TextChanged="BpmTextBox_TextChanged"/>
        </StackPanel>

        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,16,0,12"/>

        <Button x:Name="RecordButton" Content="Record" Style="{StaticResource AccentButton}" Click="RecordButton_Click" HorizontalAlignment="Left" Padding="20,8"/>
        <TextBlock x:Name="StatusText" Margin="0,10,0,0" TextWrapping="Wrap"/>

        <Button x:Name="CancelButton" Content="Cancel" Click="CancelButton_Click" HorizontalAlignment="Right" Margin="0,16,0,0"/>
    </StackPanel>
</Window>
