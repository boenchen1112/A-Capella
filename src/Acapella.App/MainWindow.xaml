<Window x:Class="Acapella.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Acapella.App"
        xmlns:vm="clr-namespace:Acapella.App.ViewModels"
        xmlns:conv="clr-namespace:Acapella.App.Converters"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        Title="Acapella" Height="820" Width="1280" MinWidth="960" MinHeight="600"
        WindowStyle="None" ResizeMode="CanResizeWithGrip" StateChanged="MainWindow_StateChanged">
    <!-- Custom chrome (v8 redesign): WindowChrome is a stock WPF class (System.Windows.Shell),
         not a new dependency; lets the toolbar row itself act as the caption (drag-to-move,
         double-click-to-maximize) while still exposing the OS resize border, with our own
         minimize/restore/close glyphs at the position the reference layout puts them. Every
         interactive control inside the CaptionHeight band needs IsHitTestVisibleInChrome="True"
         or it would only ever drag the window instead of receiving its own clicks. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="{x:Static local:MainWindow.UndoCommand}"/>
        <KeyBinding Key="Y" Modifiers="Control" Command="{x:Static local:MainWindow.RedoCommand}"/>
        <KeyBinding Key="S" Modifiers="Control" Command="{x:Static local:MainWindow.SaveCommand}"/>
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{x:Static local:MainWindow.SaveAsCommand}"/>
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static local:MainWindow.UndoCommand}" Executed="UndoCommandBinding_Executed"/>
        <CommandBinding Command="{x:Static local:MainWindow.RedoCommand}" Executed="RedoCommandBinding_Executed"/>
        <CommandBinding Command="{x:Static local:MainWindow.SaveCommand}" Executed="SaveCommandBinding_Executed"/>
        <CommandBinding Command="{x:Static local:MainWindow.SaveAsCommand}" Executed="SaveAsCommandBinding_Executed"/>
    </Window.CommandBindings>
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>

        <!-- Applied to every FX/mix-parameter slider (not the timeline or master-volume sliders,
             which have their own commit handlers): pushes an undo snapshot once the drag ends,
             not per-tick (v5 P1 task 2). -->
        <Style x:Key="CommitSlider" TargetType="Slider">
            <EventSetter Event="PreviewMouseUp" Handler="CommitSlider_PreviewMouseUp"/>
        </Style>

        <!-- Small icon-only toolbar button (transport, undo/redo, monitor, window chrome). -->
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="MinWidth" Value="30"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        </Style>

        <Style x:Key="ToolbarText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="6,0,10,0"/>
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
        </Style>

        <!-- Mixer strip: one per layer, plus a fixed Master strip. Selecting a strip (click
             anywhere on its Border) switches the FX panel's DataContext; replaces the old
             separate Editor/Mixing screens' "Open mixing" button entirely (v8 redesign). -->
        <DataTemplate x:Key="MixerStripTemplate" DataType="{x:Type vm:LayerRowViewModel}">
            <Border Width="76" Margin="0,0,6,0" Padding="6" CornerRadius="3"
                    Background="{StaticResource RowBrush}"
                    MouseDown="MixerStrip_MouseDown">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="BorderThickness" Value="2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Border Width="8" Height="8" CornerRadius="2" Background="{Binding CellColor}" Margin="0,0,4,0"/>
                        <TextBlock Text="{Binding DisplayName}" FontSize="10" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- Empty strip: record/upload choice (moved from the old Editor-screen sidebar). -->
                    <StackPanel Visibility="{Binding HasSource, Converter={StaticResource InverseBoolToVis}}">
                        <Button Content="Rec" Style="{StaticResource AccentButton}" Click="RecordChoice_Click" Padding="4,4" Margin="0,0,0,3" FontSize="10"
                                MouseEnter="Hint_MouseEnter" Tag="Record this layer."/>
                        <Button Content="Upload" Click="UploadChoice_Click" Padding="4,4" FontSize="10"
                                MouseEnter="Hint_MouseEnter" Tag="Upload a file for this layer."/>
                    </StackPanel>

                    <!-- Populated strip, top to bottom per redesign: M/S, Monitor (level meter),
                         Pan, Volume (fader), In/Out (trim). -->
                    <StackPanel Visibility="{Binding HasSource, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                            <CheckBox Content="M" IsChecked="{Binding Mute, Mode=TwoWay}" Click="CommitCheckBox_Click" Margin="0,0,6,0" MouseEnter="Hint_MouseEnter" Tag="Mute this layer."/>
                            <CheckBox Content="S" IsChecked="{Binding Solo, Mode=TwoWay}" Click="CommitCheckBox_Click" MouseEnter="Hint_MouseEnter" Tag="Solo this layer."/>
                        </StackPanel>
                        <!-- Monitor: vertical, same height as the Volume fader below, so both
                             read as a matched pair (per redesign feedback). -->
                        <ProgressBar Orientation="Vertical" Value="{Binding MeterLevel}" Minimum="0" Maximum="1" Height="150" Width="14" HorizontalAlignment="Center" Margin="0,0,0,4"
                                     MouseEnter="Hint_MouseEnter" Tag="Monitor: this layer's live level."/>
                        <Slider Style="{StaticResource CommitSlider}" Minimum="-1" Maximum="1" Value="{Binding Pan, Mode=TwoWay}" Margin="0,0,0,4" MouseEnter="Hint_MouseEnter" Tag="Pan."/>
                        <Slider Style="{StaticResource CommitSlider}" Orientation="Vertical" Minimum="-60" Maximum="12" Height="150"
                                Value="{Binding GainDb, Mode=TwoWay}" HorizontalAlignment="Center" Margin="0,0,0,4"
                                MouseEnter="Hint_MouseEnter" Tag="Volume."/>
                        <TextBlock Text="{Binding GainDisplay}" FontSize="9" HorizontalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <TextBlock Text="In" FontSize="8" Foreground="{StaticResource MutedTextBrush}" Width="14"/>
                            <TextBox Text="{Binding TrimStartMs, Mode=TwoWay}" FontSize="8" Padding="1" LostFocus="TrimTextBox_LostFocus"
                                     MouseEnter="Hint_MouseEnter" Tag="Trim start (ms)."/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Out" FontSize="8" Foreground="{StaticResource MutedTextBrush}" Width="14"/>
                            <TextBox Text="{Binding TrimEndText, Mode=TwoWay}" FontSize="8" Padding="1" LostFocus="TrimTextBox_LostFocus"
                                     MouseEnter="Hint_MouseEnter" Tag="Trim end (ms, blank = to the end)."/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <DockPanel LastChildFill="True">
        <!-- ===================== Row 1: toolbar (caption band) ===================== -->
        <!-- DockPanel, not a fixed-column Grid: a Grid's star-sized "spacer" column only absorbs
             LEFTOVER space; if the other Auto columns' combined desired width ever exceeds the
             window's actual width (e.g. after lengthening the knob/peak meter below), Grid doesn't
             wrap or clip them, so the rightmost columns (the chrome buttons!) get pushed straight
             off the visible window edge. Docking chrome + undo/redo to the right guarantees they
             stay visible no matter how wide everything else gets; that "everything else" lives in
             a horizontally-scrollable middle section instead, which absorbs overflow safely. -->
        <Border DockPanel.Dock="Top" Height="40" Background="{StaticResource RowBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel Margin="6,0" LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="MinimizeButton" Content="🗕" Click="MinimizeButton_Click" Style="{StaticResource IconButton}" MouseEnter="Hint_MouseEnter" Tag="Minimize."/>
                    <Button x:Name="RestoreButton" Content="🗗" Click="RestoreButton_Click" Style="{StaticResource IconButton}" MouseEnter="Hint_MouseEnter" Tag="Restore/maximize."/>
                    <Button x:Name="CloseButton" Content="✕" Click="CloseButton_Click" Style="{StaticResource IconButton}" Margin="0" MouseEnter="Hint_MouseEnter" Tag="Close."/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Button x:Name="UndoButton" Content="↩" Click="UndoMenuItem_Click" Style="{StaticResource IconButton}" MouseEnter="Hint_MouseEnter" Tag="Undo (Ctrl+Z)."/>
                    <Button x:Name="RedoButton" Content="↪" Click="RedoMenuItem_Click" Style="{StaticResource IconButton}" MouseEnter="Hint_MouseEnter" Tag="Redo (Ctrl+Y)."/>
                </StackPanel>

                <TextBlock x:Name="ProjectTitleText" DockPanel.Dock="Right" Style="{StaticResource ToolbarText}"
                           Foreground="{StaticResource TextBrush}" MaxWidth="220" TextTrimming="CharacterEllipsis"/>

                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal">
                        <Menu Background="Transparent" BorderThickness="0" FontSize="13" VerticalAlignment="Center"
                              shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <MenuItem Header="_File">
                                <MenuItem Header="_New" Click="NewProjectMenuItem_Click"/>
                                <MenuItem Header="_Open..." Click="OpenProjectButton_Click"/>
                                <MenuItem Header="_Save" Click="SaveMenuItem_Click" InputGestureText="Ctrl+S"/>
                                <MenuItem Header="Save _As..." Click="SaveProjectButton_Click" InputGestureText="Ctrl+Shift+S"/>
                                <Separator/>
                                <MenuItem x:Name="ExportMenuItem" Header="_Export MP4..." Click="ExportButton_Click"/>
                            </MenuItem>
                            <MenuItem Header="_Edit">
                                <MenuItem Header="_Undo" Click="UndoMenuItem_Click" InputGestureText="Ctrl+Z"/>
                                <MenuItem Header="_Redo" Click="RedoMenuItem_Click" InputGestureText="Ctrl+Y"/>
                            </MenuItem>
                            <MenuItem Header="_Add">
                                <MenuItem Header="Add _layer" Click="AddLayerMenuItem_Click"/>
                            </MenuItem>
                            <MenuItem Header="_View">
                                <MenuItem x:Name="ShowLayerLabelsMenuItem" Header="Show layer _labels" IsCheckable="True" IsChecked="True" Click="ShowLayerLabelsMenuItem_Click"/>
                            </MenuItem>
                            <MenuItem Header="_Options">
                                <MenuItem Header="_Monitor master output" IsCheckable="True" IsChecked="{Binding IsChecked, ElementName=MonitorToggle, Mode=TwoWay}"/>
                            </MenuItem>
                            <MenuItem Header="_Tools">
                                <MenuItem Header="_Recording setup..." Click="RecordingSetupMenuItem_Click"/>
                                <MenuItem Header="_Calibrate latency..." Click="RecordingSetupMenuItem_Click"/>
                                <Separator/>
                                <MenuItem Header="_Recordings folder size..." Click="RecordingsFolderSizeMenuItem_Click"/>
                            </MenuItem>
                            <MenuItem Header="_Help">
                                <MenuItem Header="_About" Click="AboutMenuItem_Click"/>
                            </MenuItem>
                        </Menu>

                        <!-- Master volume knob (compact slider stands in for a true rotary knob;
                             same position/function, see redesign notes). Two-way synced with the
                             mixer's Master strip fader further right (MasterVolumeSlider_ValueChanged
                             mirrors both). -->
                        <Slider x:Name="MasterVolumeSlider" Minimum="-24" Maximum="12" Value="0" Width="100" VerticalAlignment="Center" Margin="10,0,0,0"
                                ValueChanged="MasterVolumeSlider_ValueChanged" PreviewMouseUp="MasterVolumeSlider_PreviewMouseUp"
                                MouseEnter="Hint_MouseEnter" Tag="Master volume."
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"/>

                        <!-- Play / Stop / Record: split into three distinct buttons (image shows them
                             separate, unlike the old single toggling Play/Stop button). Record opens
                             the same capture-setup dialog as Tools > Recording setup... for the next
                             open slot. -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                            <Button x:Name="PlayButton" Content="▶" Click="PlayButton_Click" Style="{StaticResource IconButton}"
                                    MouseEnter="Hint_MouseEnter" Tag="Play the timeline from the current position (Space)."/>
                            <Button x:Name="StopButton" Content="■" Click="StopButton_Click" Style="{StaticResource IconButton}"
                                    MouseEnter="Hint_MouseEnter" Tag="Stop playback and reset to the start (Space)."/>
                            <Button x:Name="RecordButton" Content="⏺" Click="RecordButton_Click" Foreground="#E05252" Style="{StaticResource IconButton}"
                                    MouseEnter="Hint_MouseEnter" Tag="Open the recording setup dialog for the next empty layer."/>
                        </StackPanel>

                        <TextBlock Text="BPM" Style="{StaticResource ToolbarText}" Margin="10,0,4,0"/>
                        <TextBox x:Name="MetronomeBpmTextBox" Text="130.000" Width="64" VerticalAlignment="Center"
                                 LostFocus="MetronomeBpmTextBox_LostFocus" MouseEnter="Hint_MouseEnter" Tag="Metronome tempo (BPM)."
                                 shell:WindowChrome.IsHitTestVisibleInChrome="True"/>

                        <TextBlock x:Name="CurrentTimeText" Text="0:00:00" Style="{StaticResource ToolbarText}" FontFamily="Consolas" Foreground="{StaticResource TextBrush}"
                                   MouseEnter="Hint_MouseEnter" Tag="Current playback position."/>
                        <TextBlock x:Name="TotalDurationText" Text="0:00:00" Style="{StaticResource ToolbarText}" FontFamily="Consolas" Foreground="{StaticResource TextBrush}"
                                   MouseEnter="Hint_MouseEnter" Tag="Total project duration."/>

                        <ToggleButton x:Name="MonitorToggle" Content="🔊" IsChecked="True"
                                      Checked="MonitorToggle_Changed" Unchecked="MonitorToggle_Changed" Padding="6,4" Margin="6,0" VerticalAlignment="Center"
                                      MouseEnter="Hint_MouseEnter" Tag="Monitor master output (uncheck to mute what you hear without changing the volume)."
                                      shell:WindowChrome.IsHitTestVisibleInChrome="True"/>

                        <!-- Peak meter (lengthened; was too short to read at a glance). -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                            <TextBlock Text="Peak" Style="{StaticResource ToolbarText}" Margin="0,0,4,0"/>
                            <ProgressBar x:Name="ToolbarPeakMeter" Minimum="0" Maximum="1" Value="0" Width="120" Height="10"
                                         MouseEnter="Hint_MouseEnter" Tag="Master bus peak level."/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                            <TextBlock x:Name="CpuLoadText" Text="CPU 0%" Style="{StaticResource ToolbarText}" Margin="0,0,10,0"
                                       MouseEnter="Hint_MouseEnter" Tag="CPU load."/>
                            <TextBlock x:Name="MemoryUsageText" Text="0 MB" Style="{StaticResource ToolbarText}"
                                       MouseEnter="Hint_MouseEnter" Tag="Memory usage."/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ===================== Row 2: hint panel + song position ===================== -->
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="HintText" Grid.Column="0" Text="Click a mixer channel to edit its FX. Space = Play/Stop." FontSize="11"
                           Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <!-- Spans the full remaining width (next to the hint panel through to under the
                     close button), matching the reference image's plain full-width progress bar;
                     dropped the old scrollable/zoomable timeline in favor of always filling the row. -->
                <Slider x:Name="TimelineSlider" Grid.Column="1" Minimum="0" Maximum="1000" Value="0" Height="22" VerticalAlignment="Center"
                        MouseEnter="Hint_MouseEnter" Tag="Song position -- drag to seek."
                        PreviewMouseDown="TimelineSlider_PreviewMouseDown"
                        PreviewMouseUp="TimelineSlider_PreviewMouseUp"
                        ValueChanged="TimelineSlider_ValueChanged"/>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,6">
            <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedTextBrush}"/>
        </Border>

        <!-- ===================== Bottom: preview | mixer | FX (single merged screen) ===================== -->
        <Grid Background="{StaticResource WindowBrush}">
            <Grid.ColumnDefinitions>
                <!-- FX halved relative to its original share (1.2* -> 0.6*), the freed proportion
                     handed to the preview column (2* -> 2.6*, same total of 3.2 star-units) so the
                     video gets bigger instead of leaving the FX rack's old width unused. -->
                <ColumnDefinition Width="2.6*" MinWidth="300"/>
                <!-- Fixed (not Auto/star): a content-driven Auto column here could grow (or a star
                     column shrink toward its MinWidth) independently of the preview's own fixed-size
                     content, and since neither Grid column clips its child, an oversized child would
                     visibly spill into its neighbor; exactly the "mixer overlays the preview"
                     defect. A fixed width sized to fit Master + 4 strips removes that failure mode
                     outright; the inner ScrollViewer is still a safety net, not the primary fit. -->
                <ColumnDefinition Width="460"/>
                <ColumnDefinition Width="0.6*" MinWidth="260"/>
            </Grid.ColumnDefinitions>

            <!-- Preview panel: Viewbox lets the composited frame shrink to fit whatever space this
                 column actually has (rather than a fixed 640x480 that could overflow a narrow
                 window into the mixer column), while still filling as much of the panel as it can. -->
            <DockPanel Grid.Column="0" Margin="16">
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <Button x:Name="SeekBackButton" Content="−5s" Click="SeekBackButton_Click" Padding="8,5" Margin="0,0,4,0" MouseEnter="Hint_MouseEnter" Tag="Seek back 5 seconds."/>
                    <Button x:Name="RestartButton" Content="⏮ Restart" Click="RestartButton_Click" Padding="10,5" Margin="0,0,4,0" MouseEnter="Hint_MouseEnter" Tag="Restart from the beginning."/>
                    <Button x:Name="SeekForwardButton" Content="+5s" Click="SeekForwardButton_Click" Padding="8,5" MouseEnter="Hint_MouseEnter" Tag="Seek forward 5 seconds."/>
                </StackPanel>
                <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <skia:SKElement x:Name="CompositeCanvas" Width="640" Height="480" PaintSurface="CompositeCanvas_PaintSurface"/>
                    </Border>
                </Viewbox>
            </DockPanel>

            <!-- Mixer panel: Master strip (fixed) + one strip per layer -->
            <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,1,0">
                <DockPanel Margin="10">
                    <TextBlock DockPanel.Dock="Top" Text="Mixer" FontWeight="Bold" Margin="0,0,0,8"/>
                    <Button x:Name="AddLayerButton" DockPanel.Dock="Bottom" Content="+ Add layer" Click="AddLayerButton_Click" Margin="0,8,0,0"/>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal">
                            <!-- Master strip: no FX (locked product decision), just the shared
                                 master fader + peak/RMS meter; clicking it shows the FX panel's
                                 "no per-channel FX" placeholder. Same top-to-bottom order as a
                                 layer strip minus M/S/Pan (neither applies to the bus): Monitor
                                 (level meter), then the Volume fader. -->
                            <Border Width="76" Margin="0,0,10,0" Padding="6" CornerRadius="3"
                                    Background="{StaticResource RowBrush}" MouseDown="MasterStrip_MouseDown"
                                    MouseEnter="Hint_MouseEnter" Tag="Master bus -- click to see the FX panel's master info.">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="Master" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <ProgressBar x:Name="MasterMeterBar" Orientation="Vertical" Minimum="0" Maximum="1" Value="0" Height="150" Width="14" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <Slider x:Name="MixerMasterFader" Orientation="Vertical" Minimum="-24" Maximum="12" Value="0" Height="150"
                                            HorizontalAlignment="Center"
                                            ValueChanged="MixerMasterFader_ValueChanged" PreviewMouseUp="MasterVolumeSlider_PreviewMouseUp"/>
                                </StackPanel>
                            </Border>
                            <ItemsControl x:Name="TrackList" ItemTemplate="{StaticResource MixerStripTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- FX panel: switches to the selected mixer strip's chain; shows a placeholder while
                 the Master strip (or nothing) is selected. -->
            <DockPanel x:Name="FxPanel" Grid.Column="2" Margin="0">
                <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,10">
                    <TextBlock x:Name="FxHeaderText" Text="FX — Master" FontWeight="Bold" FontSize="14"/>
                </Border>

                <TextBlock x:Name="FxPlaceholderText" DockPanel.Dock="Top"
                           Text="Master bus has no per-channel FX (locked product decision). Adjust its volume via the toolbar knob or the Master fader. Select a layer's mixer strip to edit its FX chain."
                           Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="16"/>

                <ScrollViewer x:Name="FxRackScrollViewer" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel x:Name="FxRackPanel" Margin="16">
                        <!-- Slot 1: Noise gate. No power icon, no vendor label, no separate Open
                             button (redesign); the checkbox alone is enable/disable, and clicking
                             the name opens the hosted plugin's editor (only meaningful once
                             IsNoiseGateHosted; OpenNoiseGateEditor_Click no-ops otherwise). -->
                        <Border Background="{StaticResource WindowBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,10" Padding="14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <CheckBox IsChecked="{Binding NoiseGateEnabled, Mode=TwoWay}" Click="CommitCheckBox_Click" Margin="0,0,10,0" VerticalAlignment="Center"
                                              MouseEnter="Hint_MouseEnter" Tag="Enable/disable the noise gate."/>
                                    <TextBlock Text="Noise gate" FontWeight="Bold" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonUp="OpenNoiseGateEditor_Click"
                                               MouseEnter="Hint_MouseEnter" Tag="Click to open the noise gate's editor (when hosted)."/>
                                </StackPanel>
                                <Grid Visibility="{Binding IsNoiseGateHosted, Converter={StaticResource InverseBoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Threshold" VerticalAlignment="Center"/>
                                    <Slider Grid.Row="0" Grid.Column="1" Minimum="-80" Maximum="0" Value="{Binding NoiseGateThresholdDb, Mode=TwoWay}" Style="{StaticResource CommitSlider}" Margin="8,4"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding GateDisplay}" FontSize="11" Margin="4"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Release" VerticalAlignment="Center"/>
                                    <Slider Grid.Row="1" Grid.Column="1" Minimum="10" Maximum="500" Value="{Binding NoiseGateReleaseMs, Mode=TwoWay}" Style="{StaticResource CommitSlider}" Margin="8,4"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding GateReleaseDisplay}" FontSize="11" Margin="4"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Slot 2: Compressor -->
                        <Border Background="{StaticResource WindowBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,10" Padding="14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <CheckBox IsChecked="{Binding CompressorEnabled, Mode=TwoWay}" Click="CommitCheckBox_Click" Margin="0,0,10,0" VerticalAlignment="Center"
                                              MouseEnter="Hint_MouseEnter" Tag="Enable/disable the compressor."/>
                                    <TextBlock Text="Compressor" FontWeight="Bold" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonUp="OpenCompressorEditor_Click"
                                               MouseEnter="Hint_MouseEnter" Tag="Click to open the compressor's editor (when hosted)."/>
                                </StackPanel>
                                <Grid Visibility="{Binding IsCompressorHosted, Converter={StaticResource InverseBoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Threshold" VerticalAlignment="Center"/>
                                    <Slider Grid.Row="0" Grid.Column="1" Minimum="-60" Maximum="0" Value="{Binding CompressorThresholdDb, Mode=TwoWay}" Style="{StaticResource CommitSlider}" Margin="8,4"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding CompressorThresholdDisplay}" FontSize="11" Margin="4"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Ratio" VerticalAlignment="Center"/>
                                    <Slider Grid.Row="1" Grid.Column="1" Minimum="1" Maximum="20" Value="{Binding CompressorRatio, Mode=TwoWay}" Style="{StaticResource CommitSlider}" Margin="8,4"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding CompressorRatioDisplay}" FontSize="11" Margin="4"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Slot 3: EQ -->
                        <Border Background="{StaticResource WindowBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,10" Padding="14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <CheckBox IsChecked="{Binding EqEnabled, Mode=TwoWay}" Click="CommitCheckBox_Click" Margin="0,0,10,0" VerticalAlignment="Center"
                                              MouseEnter="Hint_MouseEnter" Tag="Enable/disable the EQ."/>
                                    <TextBlock Text="EQ" FontWeight="Bold" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonUp="OpenEqEditor_Click"
                                               MouseEnter="Hint_MouseEnter" Tag="Click to open the EQ's editor (when hosted)."/>
                                </StackPanel>
                                <Grid Visibility="{Binding IsEqHosted, Converter={StaticResource InverseBoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Low" VerticalAlignment="Center"/>
                                    <Slider Grid.Row="0" Grid.Column="1" Minimum="-24" Maximum="24" Value="{Binding LowShelfGainDb, Mode=TwoWay}" Style="{StaticResource CommitSlider}" Margin="8,4"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding LowEqDisplay}" FontSize="11" Margin="4"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Mid" VerticalAlignment="Center"/>
                                    <Slider Grid.Row="1" Grid.Column="1" Minimum="-24" Maximum="24" Value="{Binding MidBellGainDb, Mode=TwoWay}" Style="{StaticResource CommitSlider}" Margin="8,4"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding MidEqDisplay}" FontSize="11" Margin="4"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="High" VerticalAlignment="Center"/>
                                    <Slider Grid.Row="2" Grid.Column="1" Minimum="-24" Maximum="24" Value="{Binding HighShelfGainDb, Mode=TwoWay}" Style="{StaticResource CommitSlider}" Margin="8,4"/>
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding HighEqDisplay}" FontSize="11" Margin="4"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Slot 4: Reverb (hosted-only, no native fallback: v6 P3 task 5) -->
                        <Border Background="{StaticResource WindowBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,10" Padding="14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox IsChecked="{Binding ReverbEnabled, Mode=TwoWay}" Click="CommitCheckBox_Click" Margin="0,0,10,0" VerticalAlignment="Center" IsEnabled="{Binding IsReverbHosted}"
                                              MouseEnter="Hint_MouseEnter" Tag="Enable/disable reverb (requires FabFilter Pro-R 2)."/>
                                    <TextBlock Text="Reverb" FontWeight="Bold" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonUp="OpenReverbEditor_Click"
                                               MouseEnter="Hint_MouseEnter" Tag="Click to open reverb's editor (when hosted)."/>
                                </StackPanel>
                                <TextBlock Visibility="{Binding IsReverbHosted, Converter={StaticResource InverseBoolToVis}}"
                                           Text="Requires FabFilter Pro-R 2 (not detected on this machine) -- there is no native fallback."
                                           Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" MaxWidth="400" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Slot 5: Limiter -->
                        <Border Background="{StaticResource WindowBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,10" Padding="14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <CheckBox IsChecked="{Binding LimiterEnabled, Mode=TwoWay}" Click="CommitCheckBox_Click" Margin="0,0,10,0" VerticalAlignment="Center"
                                              MouseEnter="Hint_MouseEnter" Tag="Enable/disable the limiter."/>
                                    <TextBlock Text="Limiter" FontWeight="Bold" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonUp="OpenLimiterEditor_Click"
                                               MouseEnter="Hint_MouseEnter" Tag="Click to open the limiter's editor (when hosted)."/>
                                </StackPanel>
                                <Grid Visibility="{Binding IsLimiterHosted, Converter={StaticResource InverseBoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Ceiling" VerticalAlignment="Center"/>
                                    <Slider Grid.Row="0" Grid.Column="1" Minimum="-12" Maximum="0" Value="{Binding LimiterCeilingDb, Mode=TwoWay}" Style="{StaticResource CommitSlider}" Margin="8,4"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding LimiterCeilingDisplay}" FontSize="11" Margin="4"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Gain" VerticalAlignment="Center"/>
                                    <Slider Grid.Row="1" Grid.Column="1" Minimum="-12" Maximum="24" Value="{Binding LimiterGainDb, Mode=TwoWay}" Style="{StaticResource CommitSlider}" Margin="8,4"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding LimiterGainDisplay}" FontSize="11" Margin="4"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Pitch correction, styled the same as the FX slots above (v8 redesign):
                             checkbox enables Melodyne manual correction, clicking the name opens
                             its persistent ARA session's editor. The "Native automatic" mode
                             (PitchBackendSelection.NativeAutomatic) stays fully implemented in
                             MixEngine/LayerRowViewModel; it's just not reachable from this UI
                             anymore, since the native fallback path isn't needed here. -->
                        <Border Background="{StaticResource WindowBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,10" Padding="14">
                            <StackPanel Orientation="Horizontal">
                                <CheckBox IsChecked="{Binding MelodyneEnabled, Mode=TwoWay}" Click="CommitCheckBox_Click" Margin="0,0,10,0" VerticalAlignment="Center"
                                          MouseEnter="Hint_MouseEnter" Tag="Enable/disable Melodyne manual pitch correction."/>
                                <TextBlock Text="Pitch correction" FontWeight="Bold" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonUp="EditMelodyne_Click"
                                           MouseEnter="Hint_MouseEnter" Tag="Click to open Melodyne's editor for this layer's persistent ARA session."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
