<Window x:Class="Acapella.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Acapella.App"
        xmlns:vm="clr-namespace:Acapella.App.ViewModels"
        xmlns:conv="clr-namespace:Acapella.App.Converters"
        mc:Ignorable="d"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        Title="Acapella" Height="820" Width="1180" MinWidth="820" MinHeight="560">
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>

        <DataTemplate x:Key="TrackRowTemplate" DataType="{x:Type vm:LayerRowViewModel}">
            <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal" Margin="2">
                        <TextBlock Text="{Binding IconGlyph}" FontSize="15" Width="22" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Vertical" Margin="6,0,0,0">
                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SourceStateLabel}" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>
                </Expander.Header>

                <Grid Margin="8,8,8,10">
                    <!-- No source yet: Record / Upload choice. -->
                    <StackPanel Orientation="Horizontal" Visibility="{Binding HasSource, Converter={StaticResource InverseBoolToVis}}">
                        <Button Content="Record" Style="{StaticResource AccentButton}" Click="RecordChoice_Click" Margin="0,0,8,0" Padding="16,6"/>
                        <Button Content="Upload" Click="UploadChoice_Click" Padding="16,6"/>
                    </StackPanel>

                    <!-- Source attached: tweak controls only. -->
                    <StackPanel Visibility="{Binding HasSource, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <CheckBox Content="Mute" IsChecked="{Binding Mute, Mode=TwoWay}" Margin="0,0,16,0"/>
                            <CheckBox Content="Solo" IsChecked="{Binding Solo, Mode=TwoWay}"/>
                        </StackPanel>

                        <TextBlock Text="Pitch correction" FontSize="11" Foreground="{StaticResource MutedTextBrush}"/>
                        <ComboBox SelectedIndex="{Binding PitchBackendIndex, Mode=TwoWay}" Margin="0,2,0,2">
                            <ComboBoxItem Content="None"/>
                            <ComboBoxItem Content="Native automatic"/>
                            <ComboBoxItem Content="Melodyne manual"/>
                        </ComboBox>
                        <Button Content="Edit in Melodyne..." Click="EditMelodyne_Click"
                                Visibility="{Binding ShowMelodyneButton, Converter={StaticResource BoolToVis}}"
                                HorizontalAlignment="Left" Margin="0,2,0,6"/>

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/><RowDefinition/>
                                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Gain" VerticalAlignment="Center"/>
                            <Slider Grid.Row="0" Grid.Column="1" Minimum="-60" Maximum="12" Value="{Binding GainDb, Mode=TwoWay}" Margin="6,2"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding GainDisplay}" Margin="4,2" FontSize="11"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Pan" VerticalAlignment="Center"/>
                            <Slider Grid.Row="1" Grid.Column="1" Minimum="-1" Maximum="1" Value="{Binding Pan, Mode=TwoWay}" Margin="6,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding PanDisplay}" Margin="4,2" FontSize="11"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Low EQ" VerticalAlignment="Center"/>
                            <Slider Grid.Row="2" Grid.Column="1" Minimum="-24" Maximum="24" Value="{Binding LowShelfGainDb, Mode=TwoWay}" Margin="6,2"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding LowEqDisplay}" Margin="4,2" FontSize="11"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Mid EQ" VerticalAlignment="Center"/>
                            <Slider Grid.Row="3" Grid.Column="1" Minimum="-24" Maximum="24" Value="{Binding MidBellGainDb, Mode=TwoWay}" Margin="6,2"/>
                            <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding MidEqDisplay}" Margin="4,2" FontSize="11"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="High EQ" VerticalAlignment="Center"/>
                            <Slider Grid.Row="4" Grid.Column="1" Minimum="-24" Maximum="24" Value="{Binding HighShelfGainDb, Mode=TwoWay}" Margin="6,2"/>
                            <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding HighEqDisplay}" Margin="4,2" FontSize="11"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Gate" VerticalAlignment="Center"/>
                            <Slider Grid.Row="5" Grid.Column="1" Minimum="-80" Maximum="0" Value="{Binding NoiseGateThresholdDb, Mode=TwoWay}" Margin="6,2"/>
                            <TextBlock Grid.Row="5" Grid.Column="2" Text="{Binding GateDisplay}" Margin="4,2" FontSize="11"/>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Sync" VerticalAlignment="Center"/>
                            <Slider Grid.Row="6" Grid.Column="1" Minimum="-200" Maximum="200" Value="{Binding ManualOffsetMs, Mode=TwoWay}" Margin="6,2"/>
                            <TextBlock Grid.Row="6" Grid.Column="2" Text="{Binding OffsetDisplay}" Margin="4,2" FontSize="11"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Expander>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- Top bar -->
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Acapella" FontWeight="Bold" FontSize="18" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="OpenProjectButton" Content="Open" Click="OpenProjectButton_Click" Margin="0,0,6,0"/>
                    <Button x:Name="SaveProjectButton" Content="Save" Click="SaveProjectButton_Click" Margin="0,0,6,0"/>
                    <Button x:Name="ExportButton" Content="Export MP4..." Style="{StaticResource AccentButton}" Click="ExportButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,6">
            <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedTextBrush}"/>
        </Border>

        <!-- Track panel + Preview panel, dockable left/right (see UI_Design_Spec.md). Dock side
             of TrackPanelBorder is set in code-behind (ApplyDockSide) rather than fixed here. -->
        <DockPanel>
            <Border x:Name="TrackPanelBorder" DockPanel.Dock="Right" Width="360"
                    Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                <DockPanel Margin="10">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Tracks" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button x:Name="DockToggleButton" Grid.Column="1" Content="Dock left" Click="DockToggleButton_Click" Padding="8,3"/>
                    </Grid>

                    <Button x:Name="AddLayerButton" DockPanel.Dock="Bottom" Content="+ Add layer" Click="AddLayerButton_Click" Margin="0,8,0,0"/>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="TrackList" ItemTemplate="{StaticResource TrackRowTemplate}"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border Background="{StaticResource WindowBrush}">
                <DockPanel Margin="16">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Preview" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button x:Name="PreviewPlayButton" Grid.Column="1" Content="Play mix" Click="PreviewPlayButton_Click" Padding="14,5"/>
                    </Grid>

                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <skia:SKElement x:Name="CompositeCanvas" Width="640" Height="480" PaintSurface="CompositeCanvas_PaintSurface"/>
                    </Border>
                </DockPanel>
            </Border>
        </DockPanel>
    </DockPanel>
</Window>
