<Window x:Class="Acapella.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Acapella.App"
        xmlns:vm="clr-namespace:Acapella.App.ViewModels"
        xmlns:conv="clr-namespace:Acapella.App.Converters"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        Title="Acapella" Height="820" Width="1280" MinWidth="960" MinHeight="600"
        WindowStyle="None" ResizeMode="CanResizeWithGrip" StateChanged="MainWindow_StateChanged">
    <!-- Custom chrome (v8 redesign): WindowChrome is a stock WPF class (System.Windows.Shell),
         not a new dependency; lets the toolbar row itself act as the caption (drag-to-move,
         double-click-to-maximize) while still exposing the OS resize border, with our own
         minimize/restore/close glyphs at the position the reference layout puts them. Every
         interactive control inside the CaptionHeight band needs IsHitTestVisibleInChrome="True"
         or it would only ever drag the window instead of receiving its own clicks. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="{x:Static local:MainWindow.UndoCommand}"/>
        <KeyBinding Key="Y" Modifiers="Control" Command="{x:Static local:MainWindow.RedoCommand}"/>
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static local:MainWindow.UndoCommand}" Executed="UndoCommandBinding_Executed"/>
        <CommandBinding Command="{x:Static local:MainWindow.RedoCommand}" Executed="RedoCommandBinding_Executed"/>
    </Window.CommandBindings>
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>

        <!-- Applied to every FX/mix-parameter slider (not the timeline or master-volume sliders,
             which have their own commit handlers): pushes an undo snapshot once the drag ends,
             not per-tick (v5 P1 task 2). -->
        <Style x:Key="CommitSlider" TargetType="Slider">
            <EventSetter Event="PreviewMouseUp" Handler="CommitSlider_PreviewMouseUp"/>
        </Style>

        <!-- Small icon-only toolbar button (transport, undo/redo, monitor, window chrome). -->
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="MinWidth" Value="30"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        </Style>

        <Style x:Key="ToolbarText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="6,0,10,0"/>
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
        </Style>

        <!-- Mixer strip: one per layer, plus a fixed Master strip. Selecting a strip (click
             anywhere on its Border) switches the FX panel's DataContext; replaces the old
             separate Editor/Mixing screens' "Open mixing" button entirely (v8 redesign). -->
        <DataTemplate x:Key="MixerStripTemplate" DataType="{x:Type vm:LayerRowViewModel}">
            <Border Width="76" Margin="0,0,6,0" Padding="6" CornerRadius="3"
                    Background="{StaticResource RowBrush}"
                    MouseDown="MixerStrip_MouseDown">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="BorderThickness" Value="2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Border Width="8" Height="8" CornerRadius="2" Background="{Binding CellColor}" Margin="0,0,4,0"/>
                        <TextBlock Text="{Binding DisplayName}" FontSize="10" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- Empty strip: record/upload choice (moved from the old Editor-screen sidebar). -->
                    <StackPanel Visibility="{Binding HasSource, Converter={StaticResource InverseBoolToVis}}">
                        <Button Content="Rec" ToolTip="Record this layer" Style="{StaticResource AccentButton}" Click="RecordChoice_Click" Padding="4,4" Margin="0,0,0,3" FontSize="10"/>
                        <Button Content="Upload" ToolTip="Upload a file for this layer" Click="UploadChoice_Click" Padding="4,4" FontSize="10"/>
                    </StackPanel>

                    <!-- Populated strip: mute/solo, vertical fader + meter, pan, compact trim. -->
                    <StackPanel Visibility="{Binding HasSource, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                            <CheckBox Content="M" ToolTip="Mute" IsChecked="{Binding Mute, Mode=TwoWay}" Click="CommitCheckBox_Click" Margin="0,0,6,0"/>
                            <CheckBox Content="S" ToolTip="Solo" IsChecked="{Binding Solo, Mode=TwoWay}" Click="CommitCheckBox_Click"/>
                        </StackPanel>
                        <Grid Height="150" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0" Style="{StaticResource CommitSlider}" Orientation="Vertical" Minimum="-60" Maximum="12"
                                    Value="{Binding GainDb, Mode=TwoWay}" HorizontalAlignment="Center" ToolTip="Volume"/>
                            <ProgressBar Grid.Column="1" Orientation="Vertical" Minimum="0" Maximum="1" Value="{Binding MeterLevel}" Width="8" ToolTip="Level"/>
                        </Grid>
                        <TextBlock Text="{Binding GainDisplay}" FontSize="9" HorizontalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4"/>
                        <Slider Style="{StaticResource CommitSlider}" Minimum="-1" Maximum="1" Value="{Binding Pan, Mode=TwoWay}" ToolTip="Pan" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <TextBlock Text="In" FontSize="8" Foreground="{StaticResource MutedTextBrush}" Width="14"/>
                            <TextBox Text="{Binding TrimStartMs, Mode=TwoWay}" FontSize="8" Padding="1" LostFocus="TrimTextBox_LostFocus"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Out" FontSize="8" Foreground="{StaticResource MutedTextBrush}" Width="14"/>
                            <TextBox Text="{Binding TrimEndText, Mode=TwoWay}" FontSize="8" Padding="1" LostFocus="TrimTextBox_LostFocus" Tag="end"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <DockPanel LastChildFill="True">
        <!-- ===================== Row 1: toolbar (caption band) ===================== -->
        <Border DockPanel.Dock="Top" Height="40" Background="{StaticResource RowBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Menu Grid.Column="0" Background="Transparent" BorderThickness="0" FontSize="13" VerticalAlignment="Center"
                      shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <MenuItem Header="_File">
                        <MenuItem Header="_New" Click="NewProjectMenuItem_Click"/>
                        <MenuItem Header="_Open..." Click="OpenProjectButton_Click"/>
                        <MenuItem Header="_Save..." Click="SaveProjectButton_Click"/>
                        <Separator/>
                        <MenuItem x:Name="ExportMenuItem" Header="_Export MP4..." Click="ExportButton_Click"/>
                    </MenuItem>
                    <MenuItem Header="_Edit">
                        <MenuItem Header="_Undo" Click="UndoMenuItem_Click" InputGestureText="Ctrl+Z"/>
                        <MenuItem Header="_Redo" Click="RedoMenuItem_Click" InputGestureText="Ctrl+Y"/>
                    </MenuItem>
                    <MenuItem Header="_Add">
                        <MenuItem Header="Add _layer" Click="AddLayerMenuItem_Click"/>
                    </MenuItem>
                    <MenuItem Header="_View">
                        <MenuItem Header="Zoom _in" Click="ZoomInButton_Click"/>
                        <MenuItem Header="Zoom _out" Click="ZoomOutButton_Click"/>
                    </MenuItem>
                    <MenuItem Header="_Options">
                        <MenuItem x:Name="ShowLayerLabelsMenuItem" Header="Show layer _labels" IsCheckable="True" IsChecked="True" Click="ShowLayerLabelsMenuItem_Click"/>
                    </MenuItem>
                    <MenuItem Header="_Tools">
                        <MenuItem Header="_Recording setup..." Click="RecordingSetupMenuItem_Click"/>
                        <MenuItem Header="_Calibrate latency..." Click="RecordingSetupMenuItem_Click"/>
                        <Separator/>
                        <MenuItem Header="_Recordings folder size..." Click="RecordingsFolderSizeMenuItem_Click"/>
                    </MenuItem>
                    <MenuItem Header="_Help">
                        <MenuItem Header="_About" Click="AboutMenuItem_Click"/>
                    </MenuItem>
                </Menu>

                <!-- Master volume knob (compact slider stands in for a true rotary knob; same
                     position/function, see redesign notes). Two-way synced with the mixer's Master
                     strip fader further right (MasterVolumeSlider_ValueChanged mirrors both). -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Slider x:Name="MasterVolumeSlider" Minimum="-24" Maximum="12" Value="0" Width="60" VerticalAlignment="Center"
                            ToolTip="Master volume" ValueChanged="MasterVolumeSlider_ValueChanged" PreviewMouseUp="MasterVolumeSlider_PreviewMouseUp"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                </StackPanel>

                <!-- Play / Stop / Record: split into three distinct buttons (image shows them
                     separate, unlike the old single toggling Play/Stop button). Record opens the
                     same capture-setup dialog as Tools > Recording setup... for the next open slot. -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Button x:Name="PlayButton" Content="▶" ToolTip="Play (Space)" Click="PlayButton_Click" Style="{StaticResource IconButton}"
                            MouseEnter="Hint_MouseEnter" Tag="Play the timeline from the current position."/>
                    <Button x:Name="StopButton" Content="■" ToolTip="Stop (Space)" Click="StopButton_Click" Style="{StaticResource IconButton}"
                            MouseEnter="Hint_MouseEnter" Tag="Stop playback."/>
                    <Button x:Name="RecordButton" Content="⏺" ToolTip="Record a layer" Click="RecordButton_Click" Foreground="#E05252" Style="{StaticResource IconButton}"
                            MouseEnter="Hint_MouseEnter" Tag="Open the recording setup dialog for the next empty layer."/>
                </StackPanel>

                <TextBlock Grid.Column="3" Text="BPM" Style="{StaticResource ToolbarText}" Margin="10,0,4,0"/>
                <TextBox x:Name="MetronomeBpmTextBox" Grid.Column="4" Text="130.000" Width="64" VerticalAlignment="Center"
                         ToolTip="Metronome tempo" LostFocus="MetronomeBpmTextBox_LostFocus" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>

                <TextBlock x:Name="CurrentTimeText" Grid.Column="5" Text="0:00:00" Style="{StaticResource ToolbarText}" ToolTip="Current position" FontFamily="Consolas" Foreground="{StaticResource TextBrush}"/>
                <TextBlock x:Name="TotalDurationText" Grid.Column="6" Text="0:00:00" Style="{StaticResource ToolbarText}" ToolTip="Total duration" FontFamily="Consolas" Foreground="{StaticResource TextBrush}"/>

                <ToggleButton x:Name="MonitorToggle" Grid.Column="7" Content="🔊" ToolTip="Monitor master output" IsChecked="True"
                              Checked="MonitorToggle_Changed" Unchecked="MonitorToggle_Changed" Padding="6,4" Margin="6,0" VerticalAlignment="Center"
                              shell:WindowChrome.IsHitTestVisibleInChrome="True"/>

                <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                    <TextBlock Text="Peak" Style="{StaticResource ToolbarText}" Margin="0,0,4,0"/>
                    <ProgressBar x:Name="ToolbarPeakMeter" Minimum="0" Maximum="1" Value="0" Width="60" Height="10" ToolTip="Master peak level"/>
                </StackPanel>

                <StackPanel Grid.Column="9" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                    <TextBlock x:Name="CpuLoadText" Text="CPU 0%" Style="{StaticResource ToolbarText}" Margin="0,0,10,0"/>
                    <TextBlock x:Name="MemoryUsageText" Text="0 MB" Style="{StaticResource ToolbarText}"/>
                </StackPanel>

                <StackPanel Grid.Column="10" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="UndoButton" Content="↩" ToolTip="Undo (Ctrl+Z)" Click="UndoMenuItem_Click" Style="{StaticResource IconButton}"/>
                    <Button x:Name="RedoButton" Content="↪" ToolTip="Redo (Ctrl+Y)" Click="RedoMenuItem_Click" Style="{StaticResource IconButton}"/>
                </StackPanel>

                <!-- Column 11 (*) is the draggable spacer. -->

                <StackPanel Grid.Column="12" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="MinimizeButton" Content="🗕" ToolTip="Minimize" Click="MinimizeButton_Click" Style="{StaticResource IconButton}"/>
                    <Button x:Name="RestoreButton" Content="🗗" ToolTip="Restore/Maximize" Click="RestoreButton_Click" Style="{StaticResource IconButton}"/>
                    <Button x:Name="CloseButton" Content="✕" ToolTip="Close" Click="CloseButton_Click" Style="{StaticResource IconButton}" Margin="0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== Row 2: hint panel + song position ===================== -->
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="HintText" Grid.Column="0" Text="Click a mixer channel to edit its FX. Space = Play/Stop." FontSize="11"
                           Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <ScrollViewer x:Name="TimelineScrollViewer" Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Height="28">
                    <Slider x:Name="TimelineSlider" Minimum="0" Maximum="1000" Value="0" Height="22" Width="640" VerticalAlignment="Top"
                            ToolTip="Song position (zoom via View menu)"
                            PreviewMouseDown="TimelineSlider_PreviewMouseDown"
                            PreviewMouseUp="TimelineSlider_PreviewMouseUp"
                            ValueChanged="TimelineSlider_ValueChanged"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,6">
            <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedTextBrush}"/>
        </Border>

        <!-- ===================== Bottom: preview | mixer | FX (single merged screen) ===================== -->
        <Grid Background="{StaticResource WindowBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="360"/>
                <ColumnDefinition Width="Auto" MinWidth="260"/>
                <ColumnDefinition Width="1.2*" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <!-- Preview panel -->
            <DockPanel Grid.Column="0" Margin="16">
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <Button x:Name="SeekBackButton" Content="−5s" ToolTip="Back 5s" Click="SeekBackButton_Click" Padding="8,5" Margin="0,0,4,0"/>
                    <Button x:Name="RestartButton" Content="⏮ Restart" Click="RestartButton_Click" Padding="10,5" Margin="0,0,4,0"/>
                    <Button x:Name="SeekForwardButton" Content="+5s" ToolTip="Forward 5s" Click="SeekForwardButton_Click" Padding="8,5"/>
                </StackPanel>
                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <skia:SKElement x:Name="CompositeCanvas" Width="640" Height="480" PaintSurface="CompositeCanvas_PaintSurface"/>
                </Border>
            </DockPanel>

            <!-- Mixer panel: Master strip (fixed) + one strip per layer -->
            <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,1,0">
                <DockPanel Margin="10">
                    <TextBlock DockPanel.Dock="Top" Text="Mixer" FontWeight="Bold" Margin="0,0,0,8"/>
                    <Button x:Name="AddLayerButton" DockPanel.Dock="Bottom" Content="+ Add layer" Click="AddLayerButton_Click" Margin="0,8,0,0"/>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal">
                            <!-- Master strip: no FX (locked product decision), just the shared
                                 master fader + peak/RMS meter; clicking it shows the FX panel's
                                 "no per-channel FX" placeholder. -->
                            <Border Width="76" Margin="0,0,10,0" Padding="6" CornerRadius="3"
                                    Background="{StaticResource RowBrush}" MouseDown="MasterStrip_MouseDown">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                    </Style>
                                </Border.Style>
                                <StackPanel x:Name="MasterStripSelectionHost">
                                    <TextBlock Text="Master" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <Grid Height="150" Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="14"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="MixerMasterFader" Grid.Column="0" Orientation="Vertical" Minimum="-24" Maximum="12" Value="0"
                                                HorizontalAlignment="Center" ToolTip="Master volume"
                                                ValueChanged="MixerMasterFader_ValueChanged" PreviewMouseUp="MasterVolumeSlider_PreviewMouseUp"/>
                                        <ProgressBar x:Name="MasterMeterBar" Grid.Column="1" Orientation="Vertical" Minimum="0" Maximum="1" Value="0" Width="8" ToolTip="Master level"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <ItemsControl x:Name="TrackList" ItemTemplate="{StaticResource MixerStripTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- FX panel: switches to the selected mixer strip's chain; shows a placeholder while
                 the Master strip (or nothing) is selected. -->
            <DockPanel x:Name="FxPanel" Grid.Column="2" Margin="0">
                <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,10">
                    <TextBlock x:Name="FxHeaderText" Text="FX — Master" FontWeight="Bold" FontSize="14"/>
                </Border>

                <TextBlock x:Name="FxPlaceholderText" DockPanel.Dock="Top"
                           Text="Master bus has no per-channel FX (locked product decision). Adjust its volume via the toolbar knob or the Master fader. Select a layer's mixer strip to edit its FX chain."
                           Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="16"/>

                <ScrollViewer x:Name="FxRackScrollViewer" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel x:Name="FxRackPanel" Margin="16">
                        <!-- Slot 1: Noise gate -->
                        <Border Background="{StaticResource WindowBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,10" Padding="14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <CheckBox Content="⏻" ToolTip="Enabled" IsChecked="{Binding NoiseGateEnabled, Mode=TwoWay}" Click="CommitCheckBox_Click" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Noise gate" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="FabFilter Pro-G" Foreground="{StaticResource MutedTextBrush}" FontSize="11" VerticalAlignment="Center" Visibility="{Binding IsNoiseGateHosted, Converter={StaticResource BoolToVis}}"/>
                                    <Button Content="Open Pro-G..." ToolTip="Opens Pro-G's own native editor window for this layer's live instance" Click="OpenNoiseGateEditor_Click" Padding="10,4" Margin="10,0,0,0" Style="{StaticResource AccentButton}" Visibility="{Binding IsNoiseGateHosted, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                                <Grid Visibility="{Binding IsNoiseGateHosted, Converter={StaticResource InverseBoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Threshold" VerticalAlignment="Center"/>
                                    <Slider Grid.Row="0" Grid.Column="1" Minimum="-80" Maximum="0" Value="{Binding NoiseGateThresholdDb, Mode=TwoWay}" Style="{StaticResource CommitSlider}" Margin="8,4"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding GateDisplay}" FontSize="11" Margin="4"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Release" VerticalAlignment="Center"/>
                                    <Slider Grid.Row="1" Grid.Column="1" Minimum="10" Maximum="500" Value="{Binding NoiseGateReleaseMs, Mode=TwoWay}" Style="{StaticResource CommitSlider}" Margin="8,4"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding GateReleaseDisplay}" FontSize="11" Margin="4"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Slot 2: Compressor -->
                        <Border Background="{StaticResource WindowBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,10" Padding="14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <CheckBox Content="⏻" ToolTip="Enabled" IsChecked="{Binding CompressorEnabled, Mode=TwoWay}" Click="CommitCheckBox_Click" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Compressor" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="FabFilter Pro-C 3" Foreground="{StaticResource MutedTextBrush}" FontSize="11" VerticalAlignment="Center" Visibility="{Binding IsCompressorHosted, Converter={StaticResource BoolToVis}}"/>
                                    <Button Content="Open Pro-C 3..." ToolTip="Opens Pro-C 3's own native editor window for this layer's live instance" Click="OpenCompressorEditor_Click" Padding="10,4" Margin="10,0,0,0" Style="{StaticResource AccentButton}" Visibility="{Binding IsCompressorHosted, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                                <Grid Visibility="{Binding IsCompressorHosted, Converter={StaticResource InverseBoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Threshold" VerticalAlignment="Center"/>
                                    <Slider Grid.Row="0" Grid.Column="1" Minimum="-60" Maximum="0" Value="{Binding CompressorThresholdDb, Mode=TwoWay}" Style="{StaticResource CommitSlider}" Margin="8,4"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding CompressorThresholdDisplay}" FontSize="11" Margin="4"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Ratio" VerticalAlignment="Center"/>
                                    <Slider Grid.Row="1" Grid.Column="1" Minimum="1" Maximum="20" Value="{Binding CompressorRatio, Mode=TwoWay}" Style="{StaticResource CommitSlider}" Margin="8,4"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding CompressorRatioDisplay}" FontSize="11" Margin="4"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Slot 3: EQ -->
                        <Border Background="{StaticResource WindowBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,10" Padding="14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <CheckBox Content="⏻" ToolTip="Enabled" IsChecked="{Binding EqEnabled, Mode=TwoWay}" Click="CommitCheckBox_Click" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="EQ" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="FabFilter Pro-Q 4" Foreground="{StaticResource MutedTextBrush}" FontSize="11" VerticalAlignment="Center" Visibility="{Binding IsEqHosted, Converter={StaticResource BoolToVis}}"/>
                                    <Button Content="Open Pro-Q 4..." ToolTip="Opens Pro-Q 4's own native editor window for this layer's live instance" Click="OpenEqEditor_Click" Padding="10,4" Margin="10,0,0,0" Style="{StaticResource AccentButton}" Visibility="{Binding IsEqHosted, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                                <Grid Visibility="{Binding IsEqHosted, Converter={StaticResource InverseBoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Low" VerticalAlignment="Center"/>
                                    <Slider Grid.Row="0" Grid.Column="1" Minimum="-24" Maximum="24" Value="{Binding LowShelfGainDb, Mode=TwoWay}" Style="{StaticResource CommitSlider}" Margin="8,4"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding LowEqDisplay}" FontSize="11" Margin="4"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Mid" VerticalAlignment="Center"/>
                                    <Slider Grid.Row="1" Grid.Column="1" Minimum="-24" Maximum="24" Value="{Binding MidBellGainDb, Mode=TwoWay}" Style="{StaticResource CommitSlider}" Margin="8,4"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding MidEqDisplay}" FontSize="11" Margin="4"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="High" VerticalAlignment="Center"/>
                                    <Slider Grid.Row="2" Grid.Column="1" Minimum="-24" Maximum="24" Value="{Binding HighShelfGainDb, Mode=TwoWay}" Style="{StaticResource CommitSlider}" Margin="8,4"/>
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding HighEqDisplay}" FontSize="11" Margin="4"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Slot 4: Reverb (hosted-only, no native fallback: v6 P3 task 5) -->
                        <Border Background="{StaticResource WindowBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,10" Padding="14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox Content="⏻" ToolTip="Enabled" IsChecked="{Binding ReverbEnabled, Mode=TwoWay}" Click="CommitCheckBox_Click" Margin="0,0,10,0" VerticalAlignment="Center" IsEnabled="{Binding IsReverbHosted}"/>
                                    <TextBlock Text="Reverb" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="FabFilter Pro-R 2" Foreground="{StaticResource MutedTextBrush}" FontSize="11" VerticalAlignment="Center" Visibility="{Binding IsReverbHosted, Converter={StaticResource BoolToVis}}"/>
                                    <Button Content="Open Pro-R 2..." ToolTip="Opens Pro-R 2's own native editor window for this layer's live instance" Click="OpenReverbEditor_Click" Padding="10,4" Margin="10,0,0,0" Style="{StaticResource AccentButton}" Visibility="{Binding IsReverbHosted, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                                <TextBlock Visibility="{Binding IsReverbHosted, Converter={StaticResource InverseBoolToVis}}"
                                           Text="Requires FabFilter Pro-R 2 (not detected on this machine) -- there is no native fallback."
                                           Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" MaxWidth="400" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Slot 5: Limiter -->
                        <Border Background="{StaticResource WindowBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,10" Padding="14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <CheckBox Content="⏻" ToolTip="Enabled" IsChecked="{Binding LimiterEnabled, Mode=TwoWay}" Click="CommitCheckBox_Click" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Limiter" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="FabFilter Pro-L 2" Foreground="{StaticResource MutedTextBrush}" FontSize="11" VerticalAlignment="Center" Visibility="{Binding IsLimiterHosted, Converter={StaticResource BoolToVis}}"/>
                                    <Button Content="Open Pro-L 2..." ToolTip="Opens Pro-L 2's own native editor window for this layer's live instance" Click="OpenLimiterEditor_Click" Padding="10,4" Margin="10,0,0,0" Style="{StaticResource AccentButton}" Visibility="{Binding IsLimiterHosted, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                                <Grid Visibility="{Binding IsLimiterHosted, Converter={StaticResource InverseBoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Ceiling" VerticalAlignment="Center"/>
                                    <Slider Grid.Row="0" Grid.Column="1" Minimum="-12" Maximum="0" Value="{Binding LimiterCeilingDb, Mode=TwoWay}" Style="{StaticResource CommitSlider}" Margin="8,4"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding LimiterCeilingDisplay}" FontSize="11" Margin="4"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Gain" VerticalAlignment="Center"/>
                                    <Slider Grid.Row="1" Grid.Column="1" Minimum="-12" Maximum="24" Value="{Binding LimiterGainDb, Mode=TwoWay}" Style="{StaticResource CommitSlider}" Margin="8,4"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding LimiterGainDisplay}" FontSize="11" Margin="4"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Not a slot: pitch correction, kept separate from the FX rack above. -->
                        <Border Background="{StaticResource WindowBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,10" Padding="14">
                            <StackPanel>
                                <TextBlock Text="Pitch correction (Melodyne)" FontWeight="Bold" Margin="0,0,0,8"/>
                                <ComboBox SelectedIndex="{Binding PitchBackendIndex, Mode=TwoWay}" SelectionChanged="CommitComboBox_SelectionChanged" Margin="0,2,0,10" Width="220" HorizontalAlignment="Left">
                                    <ComboBoxItem Content="None"/>
                                    <ComboBoxItem Content="Native automatic"/>
                                    <ComboBoxItem Content="Melodyne manual"/>
                                </ComboBox>
                                <Button Content="Edit in Melodyne..." Click="EditMelodyne_Click"
                                        Visibility="{Binding ShowMelodyneButton, Converter={StaticResource BoolToVis}}"
                                        HorizontalAlignment="Left" Padding="14,6" Style="{StaticResource AccentButton}"
                                        MouseEnter="Hint_MouseEnter" Tag="Opens Melodyne's own editor window for this layer's persistent ARA session."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
