<Window x:Class="Acapella.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Acapella.App"
        xmlns:vm="clr-namespace:Acapella.App.ViewModels"
        xmlns:conv="clr-namespace:Acapella.App.Converters"
        mc:Ignorable="d"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        Title="Acapella" Height="820" Width="1180" MinWidth="820" MinHeight="560">
    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="{x:Static local:MainWindow.UndoCommand}"/>
        <KeyBinding Key="Y" Modifiers="Control" Command="{x:Static local:MainWindow.RedoCommand}"/>
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static local:MainWindow.UndoCommand}" Executed="UndoCommandBinding_Executed"/>
        <CommandBinding Command="{x:Static local:MainWindow.RedoCommand}" Executed="RedoCommandBinding_Executed"/>
    </Window.CommandBindings>
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>

        <!-- Applied to every FX/mix-parameter slider (not the timeline or master-volume sliders,
             which have their own commit handlers): pushes an undo snapshot once the drag ends,
             not per-tick (v5 P1 task 2). -->
        <Style x:Key="CommitSlider" TargetType="Slider">
            <EventSetter Event="PreviewMouseUp" Handler="CommitSlider_PreviewMouseUp"/>
        </Style>

        <!-- Editor screen: one sidebar row per layer. Minimal per UI_Design_Spec v2, just
             source-in (Record/Upload) or trim + "Open Mixing"; all FX live on Screen 2. -->
        <DataTemplate x:Key="TrackRowTemplate" DataType="{x:Type vm:LayerRowViewModel}">
            <Border Background="{StaticResource RowBrush}" CornerRadius="4" Margin="0,0,0,8" Padding="10">
                <StackPanel>
                    <!-- Name row: icon, grid-identification color chip (task 3), editable name
                         (task 1), state label. -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="{Binding IconGlyph}" FontSize="15" Width="22" VerticalAlignment="Center"/>
                        <Border Width="10" Height="10" CornerRadius="2" Background="{Binding CellColor}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Vertical" Margin="0,0,0,0">
                            <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Rename this layer"
                                     Background="Transparent" BorderThickness="0" Padding="0" FontWeight="SemiBold"
                                     LostFocus="LayerNameTextBox_LostFocus"
                                     Visibility="{Binding HasSource, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                       Visibility="{Binding HasSource, Converter={StaticResource InverseBoolToVis}}"/>
                            <TextBlock Text="{Binding SourceStateLabel}" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- No source yet: Record / Upload choice, with a hint that this row is empty
                         and excluded from save (audit B9). -->
                    <StackPanel Visibility="{Binding HasSource, Converter={StaticResource InverseBoolToVis}}">
                        <TextBlock Text="Empty — add a source, or it won't be saved with the project." FontSize="10"
                                   Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Record" Style="{StaticResource AccentButton}" Click="RecordChoice_Click" Margin="0,0,8,0" Padding="16,6"/>
                            <Button Content="Upload" Click="UploadChoice_Click" Padding="16,6"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Source attached: volume/pan/mute/solo, compact trim, open mixing. -->
                    <StackPanel Visibility="{Binding HasSource, Converter={StaticResource BoolToVis}}">
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Volume" VerticalAlignment="Center" FontSize="11"/>
                            <Slider Grid.Row="0" Grid.Column="1" Style="{StaticResource CommitSlider}" Minimum="-60" Maximum="12" Value="{Binding GainDb, Mode=TwoWay}" Margin="6,0"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding GainDisplay}" FontSize="11"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Pan" VerticalAlignment="Center" FontSize="11"/>
                            <Slider Grid.Row="1" Grid.Column="1" Style="{StaticResource CommitSlider}" Minimum="-1" Maximum="1" Value="{Binding Pan, Mode=TwoWay}" Margin="6,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding PanDisplay}" FontSize="11"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <CheckBox Content="Mute" IsChecked="{Binding Mute, Mode=TwoWay}" Click="CommitCheckBox_Click" Margin="0,0,16,0"/>
                            <CheckBox Content="Solo" IsChecked="{Binding Solo, Mode=TwoWay}" Click="CommitCheckBox_Click"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="In" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,4,0"/>
                            <TextBox Text="{Binding TrimStartMs, Mode=TwoWay}" Width="70" LostFocus="TrimTextBox_LostFocus" Margin="0,0,10,0"/>
                            <TextBlock Text="Out" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,4,0"/>
                            <TextBox Text="{Binding TrimEndText, Mode=TwoWay}" Width="70" LostFocus="TrimTextBox_LostFocus"
                                     Tag="end"/>
                        </StackPanel>
                        <Button Content="Open mixing" Click="OpenMixing_Click" HorizontalAlignment="Left" Padding="14,6"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- Menu bar (both screens), replacing the old top-bar text+buttons (v5 P1 task 1). The
             "Acapella" label stays only in the OS title bar (Window.Title), not the client area. -->
        <Menu DockPanel.Dock="Top" Background="{StaticResource RowBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" FontSize="13">
            <MenuItem Header="_File">
                <MenuItem Header="_New" Click="NewProjectMenuItem_Click"/>
                <MenuItem Header="_Open..." Click="OpenProjectButton_Click"/>
                <MenuItem Header="_Save..." Click="SaveProjectButton_Click"/>
                <Separator/>
                <MenuItem x:Name="ExportMenuItem" Header="_Export MP4..." Click="ExportButton_Click"/>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" Click="UndoMenuItem_Click" InputGestureText="Ctrl+Z"/>
                <MenuItem Header="_Redo" Click="RedoMenuItem_Click" InputGestureText="Ctrl+Y"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Zoom _in" Click="ZoomInButton_Click"/>
                <MenuItem Header="Zoom _out" Click="ZoomOutButton_Click"/>
                <Separator/>
                <MenuItem x:Name="ShowLayerLabelsMenuItem" Header="Show layer _labels" IsCheckable="True" IsChecked="True" Click="ShowLayerLabelsMenuItem_Click"/>
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="_Recording setup..." Click="RecordingSetupMenuItem_Click"/>
                <MenuItem Header="_Calibrate latency..." Click="RecordingSetupMenuItem_Click"/>
                <Separator/>
                <MenuItem Header="_Recordings folder size..." Click="RecordingsFolderSizeMenuItem_Click"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About" Click="AboutMenuItem_Click"/>
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,6">
            <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedTextBrush}"/>
        </Border>

        <Grid>
            <!-- ===================== Screen 1: Editor ===================== -->
            <DockPanel x:Name="EditorScreen">
                <Border DockPanel.Dock="Right" Width="340"
                        Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                    <DockPanel Margin="10">
                        <TextBlock DockPanel.Dock="Top" Text="Tracks" FontWeight="Bold" Margin="0,0,0,8"/>
                        <Button x:Name="AddLayerButton" DockPanel.Dock="Bottom" Content="+ Add layer" Click="AddLayerButton_Click" Margin="0,8,0,0"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="TrackList" ItemTemplate="{StaticResource TrackRowTemplate}"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <Border Background="{StaticResource WindowBrush}">
                    <DockPanel Margin="16">
                        <!-- Transport row (Clipchamp-style, v5 P1 task 3): undo/redo, -5s/play/+5s/
                             replay, elapsed/total + timeline, master volume, all in one row
                             directly under the preview so it is never scrolled off screen. The
                             preview picture shrinks first (MaxHeight) if the window gets short. -->
                        <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="UndoButton" Content="↩" ToolTip="Undo (Ctrl+Z)" Click="UndoMenuItem_Click" Padding="8,5" Margin="0,0,4,0"/>
                                <Button x:Name="RedoButton" Content="↪" ToolTip="Redo (Ctrl+Y)" Click="RedoMenuItem_Click" Padding="8,5" Margin="0,0,12,0"/>
                                <Button x:Name="SeekBackButton" Content="−5s" ToolTip="Back 5s" Click="SeekBackButton_Click" Padding="8,5" Margin="0,0,4,0"/>
                                <Button x:Name="PlayStopButton" Content="▶ Play" Click="PlayStopButton_Click" Padding="10,5" Margin="0,0,4,0"/>
                                <Button x:Name="SeekForwardButton" Content="+5s" ToolTip="Forward 5s" Click="SeekForwardButton_Click" Padding="8,5" Margin="0,0,4,0"/>
                                <Button x:Name="RestartButton" Content="⏮ Restart" Click="RestartButton_Click" Padding="10,5"/>
                            </StackPanel>

                            <Grid Grid.Column="1" Margin="12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TimeReadoutText" Grid.Column="0" Text="0:00 / 0:00" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
                                <ScrollViewer x:Name="TimelineScrollViewer" Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Height="46">
                                    <Slider x:Name="TimelineSlider" Minimum="0" Maximum="1000" Value="0"
                                            Width="640" Height="24"
                                            PreviewMouseDown="TimelineSlider_PreviewMouseDown"
                                            PreviewMouseUp="TimelineSlider_PreviewMouseUp"
                                            ValueChanged="TimelineSlider_ValueChanged"
                                            VerticalAlignment="Top"/>
                                </ScrollViewer>
                            </Grid>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Master" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="11" Foreground="{StaticResource MutedTextBrush}"/>
                                <Slider x:Name="MasterVolumeSlider" Minimum="-24" Maximum="12" Value="0" Width="100" VerticalAlignment="Center"
                                        ValueChanged="MasterVolumeSlider_ValueChanged" PreviewMouseUp="MasterVolumeSlider_PreviewMouseUp"/>
                            </StackPanel>
                        </Grid>

                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" MaxHeight="480">
                            <skia:SKElement x:Name="CompositeCanvas" Width="640" Height="480" PaintSurface="CompositeCanvas_PaintSurface"/>
                        </Border>
                    </DockPanel>
                </Border>
            </DockPanel>

            <!-- ===================== Screen 2: Mixing ===================== -->
            <DockPanel x:Name="MixingScreen" Visibility="Collapsed">
                <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="← Back to editor" Click="BackToEditor_Click" Margin="0,0,16,0"/>
                        <TextBlock Grid.Column="1" x:Name="MixingHeaderText" Text="{Binding MixingHeaderLabel}" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Mute/solo/gain/pan (v1 top strip) moved to the sidebar (v5 P2 task 2):
                     volume/pan/mute/solo now live per-layer in the Editor screen, not duplicated
                     here. -->

                <!-- Transport row (v7 Q1 task 1): the same PreviewPlaybackEngine as the Editor
                     screen's transport, so entering/leaving this screen never stops or rebuilds
                     playback; these buttons/slider share Click/ValueChanged handlers with the
                     Editor screen's transport (MainWindow.xaml.cs), just a second set of named
                     controls kept in sync by those same handlers. No video canvas here per the
                     plan (audio + meters are the feedback on this screen). -->
                <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,10">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="MixingSeekBackButton" Content="−5s" ToolTip="Back 5s" Click="SeekBackButton_Click" Padding="8,5" Margin="0,0,4,0"/>
                        <Button x:Name="MixingPlayStopButton" Content="▶ Play" Click="PlayStopButton_Click" Padding="10,5" Margin="0,0,4,0"/>
                        <Button x:Name="MixingSeekForwardButton" Content="+5s" ToolTip="Forward 5s" Click="SeekForwardButton_Click" Padding="8,5" Margin="0,0,4,0"/>
                        <Button x:Name="MixingRestartButton" Content="⏮ Restart" Click="RestartButton_Click" Padding="10,5" Margin="0,0,16,0"/>
                        <TextBlock x:Name="MixingTimeReadoutText" Text="0:00 / 0:00" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
                        <Slider x:Name="MixingTimelineSlider" Minimum="0" Maximum="1000" Value="0" Width="300" VerticalAlignment="Center"
                                PreviewMouseDown="TimelineSlider_PreviewMouseDown"
                                PreviewMouseUp="TimelineSlider_PreviewMouseUp"
                                ValueChanged="TimelineSlider_ValueChanged"/>

                        <!-- Level meters (v7 Q1 task 3): peak/RMS taps read from the live
                             PreviewPlaybackEngine at ~30Hz (MainWindow's _meterPollTimer), not
                             data-bound; these are plain post-slot-rack/master bus dBFS readouts,
                             not project state. -->
                        <TextBlock Text="Layer" VerticalAlignment="Center" Margin="16,0,4,0" FontSize="11" Foreground="{StaticResource MutedTextBrush}"/>
                        <ProgressBar x:Name="LayerMeterBar" Minimum="0" Maximum="1" Value="0" Width="80" Height="12" VerticalAlignment="Center" ToolTip="Selected layer's RMS level, -60 to 0 dBFS"/>
                        <TextBlock Text="Master" VerticalAlignment="Center" Margin="10,0,4,0" FontSize="11" Foreground="{StaticResource MutedTextBrush}"/>
                        <ProgressBar x:Name="MasterMeterBar" Minimum="0" Maximum="1" Value="0" Width="80" Height="12" VerticalAlignment="Center" ToolTip="Master bus RMS level, -60 to 0 dBFS"/>
                    </StackPanel>
                </Border>

                <!-- Slot rack (v7 Q1 task 2): five fixed slots in the same order MixEngine's
                     BuildLayerChain processes them (NoiseGate -> Compressor -> EQ -> Reverb ->
                     Limiter; Pan/Gain sit between EQ and Reverb/Limiter but aren't slots, they
                     live in the sidebar. Each slot always shows a power toggle + FX name; the
                     "Open Pro-X..." launcher only appears once that plugin is detected, and the
                     native-fallback sliders only appear while the slot is both enabled and no
                     matching plugin is hosted (the only place native controls appear at all, per
                     the plan's no-"backend"-wording rule); replaces the old per-FX subtab
                     selector with everything visible/scrollable at once, like a DAW channel strip. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <!-- Slot 1: Noise gate -->
                        <Border Background="{StaticResource WindowBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,10" Padding="14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <CheckBox Content="⏻" ToolTip="Enabled" IsChecked="{Binding NoiseGateEnabled, Mode=TwoWay}" Click="CommitCheckBox_Click" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Noise gate" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="FabFilter Pro-G" Foreground="{StaticResource MutedTextBrush}" FontSize="11" VerticalAlignment="Center" Visibility="{Binding IsNoiseGateHosted, Converter={StaticResource BoolToVis}}"/>
                                    <Button Content="Open Pro-G..." Click="OpenNoiseGateEditor_Click" Padding="10,4" Margin="10,0,0,0" Style="{StaticResource AccentButton}" Visibility="{Binding IsNoiseGateHosted, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                                <Grid Visibility="{Binding IsNoiseGateHosted, Converter={StaticResource InverseBoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Threshold" VerticalAlignment="Center"/>
                                    <Slider Grid.Row="0" Grid.Column="1" Minimum="-80" Maximum="0" Value="{Binding NoiseGateThresholdDb, Mode=TwoWay}" Style="{StaticResource CommitSlider}" Margin="8,4"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding GateDisplay}" FontSize="11" Margin="4"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Release" VerticalAlignment="Center"/>
                                    <Slider Grid.Row="1" Grid.Column="1" Minimum="10" Maximum="500" Value="{Binding NoiseGateReleaseMs, Mode=TwoWay}" Style="{StaticResource CommitSlider}" Margin="8,4"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding GateReleaseDisplay}" FontSize="11" Margin="4"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Slot 2: Compressor -->
                        <Border Background="{StaticResource WindowBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,10" Padding="14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <CheckBox Content="⏻" ToolTip="Enabled" IsChecked="{Binding CompressorEnabled, Mode=TwoWay}" Click="CommitCheckBox_Click" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Compressor" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="FabFilter Pro-C 3" Foreground="{StaticResource MutedTextBrush}" FontSize="11" VerticalAlignment="Center" Visibility="{Binding IsCompressorHosted, Converter={StaticResource BoolToVis}}"/>
                                    <Button Content="Open Pro-C 3..." Click="OpenCompressorEditor_Click" Padding="10,4" Margin="10,0,0,0" Style="{StaticResource AccentButton}" Visibility="{Binding IsCompressorHosted, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                                <Grid Visibility="{Binding IsCompressorHosted, Converter={StaticResource InverseBoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Threshold" VerticalAlignment="Center"/>
                                    <Slider Grid.Row="0" Grid.Column="1" Minimum="-60" Maximum="0" Value="{Binding CompressorThresholdDb, Mode=TwoWay}" Style="{StaticResource CommitSlider}" Margin="8,4"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding CompressorThresholdDisplay}" FontSize="11" Margin="4"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Ratio" VerticalAlignment="Center"/>
                                    <Slider Grid.Row="1" Grid.Column="1" Minimum="1" Maximum="20" Value="{Binding CompressorRatio, Mode=TwoWay}" Style="{StaticResource CommitSlider}" Margin="8,4"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding CompressorRatioDisplay}" FontSize="11" Margin="4"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Slot 3: EQ -->
                        <Border Background="{StaticResource WindowBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,10" Padding="14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <CheckBox Content="⏻" ToolTip="Enabled" IsChecked="{Binding EqEnabled, Mode=TwoWay}" Click="CommitCheckBox_Click" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="EQ" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="FabFilter Pro-Q 4" Foreground="{StaticResource MutedTextBrush}" FontSize="11" VerticalAlignment="Center" Visibility="{Binding IsEqHosted, Converter={StaticResource BoolToVis}}"/>
                                    <Button Content="Open Pro-Q 4..." Click="OpenEqEditor_Click" Padding="10,4" Margin="10,0,0,0" Style="{StaticResource AccentButton}" Visibility="{Binding IsEqHosted, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                                <Grid Visibility="{Binding IsEqHosted, Converter={StaticResource InverseBoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Low" VerticalAlignment="Center"/>
                                    <Slider Grid.Row="0" Grid.Column="1" Minimum="-24" Maximum="24" Value="{Binding LowShelfGainDb, Mode=TwoWay}" Style="{StaticResource CommitSlider}" Margin="8,4"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding LowEqDisplay}" FontSize="11" Margin="4"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Mid" VerticalAlignment="Center"/>
                                    <Slider Grid.Row="1" Grid.Column="1" Minimum="-24" Maximum="24" Value="{Binding MidBellGainDb, Mode=TwoWay}" Style="{StaticResource CommitSlider}" Margin="8,4"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding MidEqDisplay}" FontSize="11" Margin="4"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="High" VerticalAlignment="Center"/>
                                    <Slider Grid.Row="2" Grid.Column="1" Minimum="-24" Maximum="24" Value="{Binding HighShelfGainDb, Mode=TwoWay}" Style="{StaticResource CommitSlider}" Margin="8,4"/>
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding HighEqDisplay}" FontSize="11" Margin="4"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Slot 4: Reverb (hosted-only, no native fallback: v6 P3 task 5) -->
                        <Border Background="{StaticResource WindowBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,10" Padding="14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox Content="⏻" ToolTip="Enabled" IsChecked="{Binding ReverbEnabled, Mode=TwoWay}" Click="CommitCheckBox_Click" Margin="0,0,10,0" VerticalAlignment="Center" IsEnabled="{Binding IsReverbHosted}"/>
                                    <TextBlock Text="Reverb" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="FabFilter Pro-R 2" Foreground="{StaticResource MutedTextBrush}" FontSize="11" VerticalAlignment="Center" Visibility="{Binding IsReverbHosted, Converter={StaticResource BoolToVis}}"/>
                                    <Button Content="Open Pro-R 2..." Click="OpenReverbEditor_Click" Padding="10,4" Margin="10,0,0,0" Style="{StaticResource AccentButton}" Visibility="{Binding IsReverbHosted, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                                <TextBlock Visibility="{Binding IsReverbHosted, Converter={StaticResource InverseBoolToVis}}"
                                           Text="Requires FabFilter Pro-R 2 (not detected on this machine) -- there is no native fallback."
                                           Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" MaxWidth="400" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Slot 5: Limiter -->
                        <Border Background="{StaticResource WindowBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,10" Padding="14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <CheckBox Content="⏻" ToolTip="Enabled" IsChecked="{Binding LimiterEnabled, Mode=TwoWay}" Click="CommitCheckBox_Click" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Limiter" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="FabFilter Pro-L 2" Foreground="{StaticResource MutedTextBrush}" FontSize="11" VerticalAlignment="Center" Visibility="{Binding IsLimiterHosted, Converter={StaticResource BoolToVis}}"/>
                                    <Button Content="Open Pro-L 2..." Click="OpenLimiterEditor_Click" Padding="10,4" Margin="10,0,0,0" Style="{StaticResource AccentButton}" Visibility="{Binding IsLimiterHosted, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                                <Grid Visibility="{Binding IsLimiterHosted, Converter={StaticResource InverseBoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Ceiling" VerticalAlignment="Center"/>
                                    <Slider Grid.Row="0" Grid.Column="1" Minimum="-12" Maximum="0" Value="{Binding LimiterCeilingDb, Mode=TwoWay}" Style="{StaticResource CommitSlider}" Margin="8,4"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding LimiterCeilingDisplay}" FontSize="11" Margin="4"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Gain" VerticalAlignment="Center"/>
                                    <Slider Grid.Row="1" Grid.Column="1" Minimum="-12" Maximum="24" Value="{Binding LimiterGainDb, Mode=TwoWay}" Style="{StaticResource CommitSlider}" Margin="8,4"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding LimiterGainDisplay}" FontSize="11" Margin="4"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Not a slot: pitch correction, kept separate from the FX rack above. -->
                        <Border Background="{StaticResource WindowBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,10" Padding="14">
                            <StackPanel>
                                <TextBlock Text="Pitch correction (Melodyne)" FontWeight="Bold" Margin="0,0,0,8"/>
                                <ComboBox SelectedIndex="{Binding PitchBackendIndex, Mode=TwoWay}" SelectionChanged="CommitComboBox_SelectionChanged" Margin="0,2,0,10" Width="220" HorizontalAlignment="Left">
                                    <ComboBoxItem Content="None"/>
                                    <ComboBoxItem Content="Native automatic"/>
                                    <ComboBoxItem Content="Melodyne manual"/>
                                </ComboBox>
                                <Button Content="Edit in Melodyne..." Click="EditMelodyne_Click"
                                        Visibility="{Binding ShowMelodyneButton, Converter={StaticResource BoolToVis}}"
                                        HorizontalAlignment="Left" Padding="14,6" Style="{StaticResource AccentButton}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
