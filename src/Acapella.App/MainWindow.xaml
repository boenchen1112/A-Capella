<Window x:Class="Acapella.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Acapella.App"
        mc:Ignorable="d"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        Title="Acapella" Height="900" Width="700">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="10">
        <TextBlock Text="Project" FontWeight="Bold" Margin="0,0,0,4"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="SaveProjectButton" Content="Save Project..." Click="SaveProjectButton_Click" Margin="0,0,4,0"/>
            <Button x:Name="OpenProjectButton" Content="Open Project..." Click="OpenProjectButton_Click"/>
        </StackPanel>

        <TextBlock Text="Devices" FontWeight="Bold" Margin="0,0,0,4"/>
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Video In:" Margin="0,2"/>
            <ComboBox Grid.Row="0" Grid.Column="1" x:Name="VideoDeviceCombo" Margin="4,2"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Audio In:" Margin="0,2"/>
            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="AudioInDeviceCombo" Margin="4,2"/>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Audio Out:" Margin="0,2"/>
            <ComboBox Grid.Row="2" Grid.Column="1" x:Name="AudioOutDeviceCombo" Margin="4,2"/>
        </Grid>
        <Button x:Name="RefreshDevicesButton" Content="Refresh Devices" Click="RefreshDevicesButton_Click" Margin="0,0,0,4" HorizontalAlignment="Left"/>
        <Button x:Name="CalibrateButton" Content="Calibrate Latency (uses Audio In as loopback)" Click="CalibrateButton_Click" Margin="0,0,0,4" HorizontalAlignment="Left"/>
        <TextBlock x:Name="CalibrationResultText" Margin="0,0,0,8"/>

        <TextBlock Text="Metronome" FontWeight="Bold" Margin="0,4,0,4"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <CheckBox x:Name="MetronomeToggle" Content="Enabled" VerticalAlignment="Center" Checked="MetronomeToggle_Changed" Unchecked="MetronomeToggle_Changed"/>
            <TextBlock Text="BPM:" Margin="12,0,4,0" VerticalAlignment="Center"/>
            <TextBox x:Name="BpmTextBox" Width="50" Text="120" TextChanged="BpmTextBox_TextChanged"/>
        </StackPanel>

        <TextBlock Text="Layers (max 4)" FontWeight="Bold" Margin="0,4,0,4"/>
        <ListBox x:Name="LayersList" Height="100" SelectionChanged="LayersList_SelectionChanged"/>
        <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
            <Button x:Name="RecordLayerButton" Content="Record Layer" Click="RecordLayerButton_Click" Margin="0,0,4,0"/>
            <Button x:Name="StopRecordButton" Content="Stop Recording" Click="StopRecordButton_Click" Margin="0,0,4,0"/>
            <Button x:Name="UploadLayerButton" Content="Upload Layer..." Click="UploadLayerButton_Click"/>
        </StackPanel>

        <TextBlock Text="Manual Fine-Tune Offset (ms)" Margin="0,8,0,0"/>
        <Slider x:Name="OffsetSlider" Minimum="-200" Maximum="200" TickFrequency="10" IsSnapToTickEnabled="False" ValueChanged="OffsetSlider_ValueChanged"/>
        <TextBlock x:Name="OffsetValueText" Text="0 ms"/>

        <TextBlock Text="Mixer — Selected Layer Channel Strip" FontWeight="Bold" Margin="0,10,0,4"/>
        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Gain (dB):" Margin="0,2"/>
            <Slider Grid.Row="0" Grid.Column="1" x:Name="GainSlider" Minimum="-60" Maximum="12" ValueChanged="MixParam_ValueChanged" Margin="4,2"/>
            <TextBlock Grid.Row="0" Grid.Column="2" x:Name="GainValueText" Text="0 dB" Margin="4,2"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Pan:" Margin="0,2"/>
            <Slider Grid.Row="1" Grid.Column="1" x:Name="PanSlider" Minimum="-1" Maximum="1" ValueChanged="MixParam_ValueChanged" Margin="4,2"/>
            <TextBlock Grid.Row="1" Grid.Column="2" x:Name="PanValueText" Text="0" Margin="4,2"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Low Shelf (dB):" Margin="0,2"/>
            <Slider Grid.Row="2" Grid.Column="1" x:Name="LowEqSlider" Minimum="-24" Maximum="24" ValueChanged="MixParam_ValueChanged" Margin="4,2"/>
            <TextBlock Grid.Row="2" Grid.Column="2" x:Name="LowEqValueText" Text="0 dB" Margin="4,2"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Mid Bell (dB):" Margin="0,2"/>
            <Slider Grid.Row="3" Grid.Column="1" x:Name="MidEqSlider" Minimum="-24" Maximum="24" ValueChanged="MixParam_ValueChanged" Margin="4,2"/>
            <TextBlock Grid.Row="3" Grid.Column="2" x:Name="MidEqValueText" Text="0 dB" Margin="4,2"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="High Shelf (dB):" Margin="0,2"/>
            <Slider Grid.Row="4" Grid.Column="1" x:Name="HighEqSlider" Minimum="-24" Maximum="24" ValueChanged="MixParam_ValueChanged" Margin="4,2"/>
            <TextBlock Grid.Row="4" Grid.Column="2" x:Name="HighEqValueText" Text="0 dB" Margin="4,2"/>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Gate Threshold (dB):" Margin="0,2"/>
            <Slider Grid.Row="5" Grid.Column="1" x:Name="GateThresholdSlider" Minimum="-80" Maximum="0" ValueChanged="MixParam_ValueChanged" Margin="4,2"/>
            <TextBlock Grid.Row="5" Grid.Column="2" x:Name="GateThresholdValueText" Text="-60 dB" Margin="4,2"/>

            <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,4,0,0">
                <CheckBox x:Name="MuteCheckBox" Content="Mute" Checked="MixParam_ValueChanged" Unchecked="MixParam_ValueChanged" Margin="0,0,12,0"/>
                <CheckBox x:Name="SoloCheckBox" Content="Solo" Checked="MixParam_ValueChanged" Unchecked="MixParam_ValueChanged" Margin="0,0,12,0"/>
                <TextBlock Text="Pitch:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox x:Name="PitchBackendCombo" Width="140" SelectionChanged="MixParam_ValueChanged">
                    <ComboBoxItem Content="None" IsSelected="True"/>
                    <ComboBoxItem Content="Automatic (2B)"/>
                    <ComboBoxItem Content="Manual/Melodyne (2A)"/>
                </ComboBox>
            </StackPanel>
        </Grid>
        <Button x:Name="PreviewMixButton" Content="Preview Mix" Click="PreviewMixButton_Click" Margin="0,4,0,4" HorizontalAlignment="Left"/>

        <TextBlock Text="Composited Preview (2x2 Grid)" FontWeight="Bold" Margin="0,10,0,4"/>
        <Button x:Name="CompositePreviewButton" Content="Refresh Composite Preview" Click="CompositePreviewButton_Click" Margin="0,0,0,4" HorizontalAlignment="Left"/>
        <skia:SKElement x:Name="CompositeCanvas" Width="480" Height="360" HorizontalAlignment="Left" PaintSurface="CompositeCanvas_PaintSurface"/>

        <TextBlock x:Name="StatusText" Margin="0,10,0,0" Foreground="DarkBlue"/>
    </StackPanel>
    </ScrollViewer>
</Window>
