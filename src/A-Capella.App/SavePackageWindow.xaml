<Window x:Class="A_Capella.App.SavePackageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Save as package" Height="190" Width="380" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock Text="Name this combination of effects" Margin="0,0,0,6"/>
        <TextBox x:Name="NameBox" MaxLength="60" KeyDown="NameBox_KeyDown"/>
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" IsCancel="True" Padding="14,5" Margin="0,0,8,0"/>
            <Button Content="Save" IsDefault="True" Click="Save_Click" Padding="14,5" Style="{StaticResource AccentButton}"/>
        </StackPanel>
    </StackPanel>
</Window>
