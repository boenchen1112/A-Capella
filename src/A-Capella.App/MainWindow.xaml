<Window x:Class="A_Capella.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:A_Capella.App"
        xmlns:vm="clr-namespace:A_Capella.App.ViewModels"
        xmlns:conv="clr-namespace:A_Capella.App.Converters"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        Title="A-Capella" Height="900" Width="1440" MinWidth="960" MinHeight="600"
        WindowStyle="None" ResizeMode="CanResizeWithGrip" StateChanged="MainWindow_StateChanged"
        Background="{StaticResource GroundBrush}">
    <!-- Custom chrome: WindowChrome is a stock WPF class (System.Windows.Shell), not
         a new dependency; lets the title bar itself act as the caption (drag-to-move,
         double-click-to-maximize) while still exposing the OS resize border. Every interactive
         control inside the CaptionHeight band needs IsHitTestVisibleInChrome="True" or it would
         only ever drag the window instead of receiving its own clicks. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="{x:Static local:MainWindow.UndoCommand}"/>
        <KeyBinding Key="Y" Modifiers="Control" Command="{x:Static local:MainWindow.RedoCommand}"/>
        <KeyBinding Key="S" Modifiers="Control" Command="{x:Static local:MainWindow.SaveCommand}"/>
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{x:Static local:MainWindow.SaveAsCommand}"/>
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static local:MainWindow.UndoCommand}" Executed="UndoCommandBinding_Executed"/>
        <CommandBinding Command="{x:Static local:MainWindow.RedoCommand}" Executed="RedoCommandBinding_Executed"/>
        <CommandBinding Command="{x:Static local:MainWindow.SaveCommand}" Executed="SaveCommandBinding_Executed"/>
        <CommandBinding Command="{x:Static local:MainWindow.SaveAsCommand}" Executed="SaveAsCommandBinding_Executed"/>
    </Window.CommandBindings>
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
        <conv:FullSourceBarGeometryConverter x:Key="FullSourceBarGeom"/>
        <conv:TrimmedBarGeometryConverter x:Key="TrimmedBarGeom"/>
        <conv:UnitToHeightConverter x:Key="UnitToHeight"/>
        <conv:PitchModeEqualsConverter x:Key="PitchModeEquals"/>
        <conv:TrimHandleXConverter x:Key="TrimHandleX"/>

        <!-- A lane's drag-to-trim handle: a plain filled bar, no chrome beyond that; it's small
             and only ever seen hovering over the lane's own accent-colored clip bars. -->
        <Style x:Key="TrimHandleThumb" TargetType="Thumb">
            <Setter Property="Background" Value="{StaticResource TextBrush}"/>
            <Setter Property="Cursor" Value="SizeWE"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{TemplateBinding Background}" CornerRadius="2" Opacity="0.85"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Applied to every FX/mix-parameter slider (not the timeline or master-volume sliders,
             which have their own commit handlers): pushes an undo snapshot once the drag ends, not
             per-tick. Also on PreviewKeyUp, since Slider.Value binds TwoWay with the
             framework-default PropertyChanged trigger, so a keyboard-driven edit already applies
             live with nothing else to catch it. -->
        <Style x:Key="CommitSlider" TargetType="Slider">
            <EventSetter Event="PreviewMouseUp" Handler="CommitSlider_PreviewMouseUp"/>
            <EventSetter Event="PreviewKeyUp" Handler="CommitSlider_PreviewKeyUp"/>
        </Style>

        <!-- One lane row: 248px name/meter section + a relative clip track showing the full-source
             (dashed) span and the trimmed (solid) span as proportional bars, with drag handles at
             both ends of the solid span. Dragging a handle sets TrimStartMs/TrimEndMs live
             (MainWindow's TrimHandle_DragDelta); the channel panel's In/Out text boxes read and
             write the same two properties, so either path stays in sync with the other. -->
        <DataTemplate x:Key="LaneRowTemplate" DataType="{x:Type vm:LayerRowViewModel}">
            <Grid Height="62" Background="Transparent" MouseDown="LaneRow_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="248"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.ColumnSpan="2" VerticalAlignment="Bottom" Height="1" Background="{StaticResource SubtleLineBrush}"/>
                <Border Grid.ColumnSpan="2" BorderThickness="2" CornerRadius="2">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource StrongBorderBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>

                <Border Grid.Column="0" BorderThickness="4,0,0,0" BorderBrush="{Binding CellColor}" Padding="10,0,0,0">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                            <CheckBox Style="{StaticResource LaneToggleButton}" Content="M" IsChecked="{Binding Mute, Mode=TwoWay}" Click="CommitCheckBox_Click" Margin="0,0,4,0"/>
                            <CheckBox Style="{StaticResource LaneToggleButton}" Content="S" IsChecked="{Binding Solo, Mode=TwoWay}" Click="CommitCheckBox_Click" Margin="0,0,8,0"/>
                            <Grid Width="6" Height="36">
                                <Border Background="{StaticResource ControlBrush}" CornerRadius="3"/>
                                <Border Background="{StaticResource MeterGreenBrush}" CornerRadius="3" VerticalAlignment="Bottom"
                                        Height="{Binding MeterLevel, Converter={StaticResource UnitToHeight}, ConverterParameter=36}"/>
                            </Grid>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <DockPanel LastChildFill="True">
                                <TextBlock DockPanel.Dock="Right" Text="❄ FROZEN" FontSize="10" Foreground="{StaticResource SoloAmberBrush}"
                                           Visibility="{Binding Frozen, Converter={StaticResource BoolToVis}}" Margin="6,0,0,0"/>
                                <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=Explicit}" Style="{StaticResource InlineTextBox}"
                                         FontFamily="{StaticResource PlexSansMedium}" FontSize="13"
                                         GotFocus="LaneNameTextBox_GotFocus" LostFocus="LaneNameTextBox_LostFocus" KeyDown="LaneNameTextBox_KeyDown"/>
                            </DockPanel>
                            <TextBlock Text="{Binding SourceLabel}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Canvas Grid.Column="1" x:Name="ClipTrack" Background="Transparent">
                    <Border Canvas.Top="11" Height="40" CornerRadius="5" Opacity="0.3"
                            Background="{Binding CellColor}" BorderBrush="{Binding CellColor}" BorderThickness="1"
                            Visibility="{Binding HasSource, Converter={StaticResource BoolToVis}}">
                        <Border.Width>
                            <MultiBinding Converter="{StaticResource FullSourceBarGeom}" ConverterParameter="Width">
                                <Binding Path="SourceDurationMs"/>
                                <Binding Path="TimelineDurationMs"/>
                                <Binding ElementName="ClipTrack" Path="ActualWidth"/>
                            </MultiBinding>
                        </Border.Width>
                        <Canvas.Left>
                            <MultiBinding Converter="{StaticResource FullSourceBarGeom}">
                                <Binding Path="SourceDurationMs"/>
                                <Binding Path="TimelineDurationMs"/>
                                <Binding ElementName="ClipTrack" Path="ActualWidth"/>
                            </MultiBinding>
                        </Canvas.Left>
                    </Border>
                    <Border Canvas.Top="11" Height="40" CornerRadius="5"
                            Background="{Binding CellColor}" BorderBrush="{Binding CellColor}" BorderThickness="1"
                            Visibility="{Binding HasSource, Converter={StaticResource BoolToVis}}">
                        <Border.Width>
                            <MultiBinding Converter="{StaticResource TrimmedBarGeom}" ConverterParameter="Width">
                                <Binding Path="TrimStartMs"/>
                                <Binding Path="EffectiveTrimEndMs"/>
                                <Binding Path="TimelineDurationMs"/>
                                <Binding ElementName="ClipTrack" Path="ActualWidth"/>
                            </MultiBinding>
                        </Border.Width>
                        <Canvas.Left>
                            <MultiBinding Converter="{StaticResource TrimmedBarGeom}">
                                <Binding Path="TrimStartMs"/>
                                <Binding Path="EffectiveTrimEndMs"/>
                                <Binding Path="TimelineDurationMs"/>
                                <Binding ElementName="ClipTrack" Path="ActualWidth"/>
                            </MultiBinding>
                        </Canvas.Left>
                    </Border>

                    <Thumb Tag="In" Canvas.Top="11" Width="10" Height="40" Style="{StaticResource TrimHandleThumb}"
                           Visibility="{Binding HasSource, Converter={StaticResource BoolToVis}}"
                           DragStarted="TrimHandle_DragStarted" DragDelta="TrimHandle_DragDelta" DragCompleted="TrimHandle_DragCompleted">
                        <Canvas.Left>
                            <MultiBinding Converter="{StaticResource TrimHandleX}" ConverterParameter="In">
                                <Binding Path="TrimStartMs"/>
                                <Binding Path="EffectiveTrimEndMs"/>
                                <Binding Path="TimelineDurationMs"/>
                                <Binding ElementName="ClipTrack" Path="ActualWidth"/>
                            </MultiBinding>
                        </Canvas.Left>
                    </Thumb>
                    <Thumb Tag="Out" Canvas.Top="11" Width="10" Height="40" Style="{StaticResource TrimHandleThumb}"
                           Visibility="{Binding HasSource, Converter={StaticResource BoolToVis}}"
                           DragStarted="TrimHandle_DragStarted" DragDelta="TrimHandle_DragDelta" DragCompleted="TrimHandle_DragCompleted">
                        <Canvas.Left>
                            <MultiBinding Converter="{StaticResource TrimHandleX}" ConverterParameter="Out">
                                <Binding Path="TrimStartMs"/>
                                <Binding Path="EffectiveTrimEndMs"/>
                                <Binding Path="TimelineDurationMs"/>
                                <Binding ElementName="ClipTrack" Path="ActualWidth"/>
                            </MultiBinding>
                        </Canvas.Left>
                    </Thumb>
                </Canvas>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <DockPanel LastChildFill="True">
        <!-- ===================== Title bar (caption band) ===================== -->
        <Border DockPanel.Dock="Top" Height="44" Background="{StaticResource GroundBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 2x2 logo mark, matching the mock's four layer-accent squares. -->
                    <UniformGrid Rows="2" Columns="2" Width="18" Height="18" Margin="0,0,10,0">
                        <Border Background="{StaticResource LayerAccent1Brush}" Margin="0.5"/>
                        <Border Background="{StaticResource LayerAccent2Brush}" Margin="0.5"/>
                        <Border Background="{StaticResource LayerAccent3Brush}" Margin="0.5"/>
                        <Border Background="{StaticResource LayerAccent4Brush}" Margin="0.5"/>
                    </UniformGrid>

                    <Menu Background="Transparent" BorderThickness="0" FontSize="13" VerticalAlignment="Center"
                          shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <MenuItem Header="_File">
                            <MenuItem Header="_New" Click="NewProjectMenuItem_Click"/>
                            <MenuItem Header="_Open..." Click="OpenProjectButton_Click"/>
                            <MenuItem Header="_Save" Click="SaveMenuItem_Click" InputGestureText="Ctrl+S"/>
                            <MenuItem Header="Save _As..." Click="SaveProjectButton_Click" InputGestureText="Ctrl+Shift+S"/>
                            <Separator/>
                            <MenuItem x:Name="ExportMenuItem" Header="_Export MP4..." Click="ExportButton_Click"/>
                        </MenuItem>
                        <MenuItem Header="_Edit">
                            <MenuItem Header="_Undo" Click="UndoMenuItem_Click" InputGestureText="Ctrl+Z"/>
                            <MenuItem Header="_Redo" Click="RedoMenuItem_Click" InputGestureText="Ctrl+Y"/>
                        </MenuItem>
                        <MenuItem Header="_Layers">
                            <MenuItem Header="Import _files as layers..." Click="ImportFilesMenuItem_Click"/>
                            <MenuItem Header="_Delete selected layer" Click="DeleteLayerMenuItem_Click"/>
                        </MenuItem>
                        <MenuItem Header="La_yout">
                            <MenuItem Header="Choose _layout..." Click="ChooseLayoutMenuItem_Click"/>
                            <MenuItem Header="_Video settings..." Click="VideoSettingsMenuItem_Click"/>
                        </MenuItem>
                        <MenuItem Header="_Song">
                            <MenuItem Header="Set Song _In" Click="SetSongInMenuItem_Click" InputGestureText="I"/>
                            <MenuItem Header="Set Song _Out" Click="SetSongOutMenuItem_Click" InputGestureText="O"/>
                            <MenuItem Header="_Clear Song In/Out" Click="ClearSongRangeMenuItem_Click"/>
                        </MenuItem>
                        <MenuItem Header="_View">
                            <MenuItem x:Name="ShowLayerLabelsMenuItem" Header="Show layer _labels" IsCheckable="True" IsChecked="True" Click="ShowLayerLabelsMenuItem_Click"/>
                        </MenuItem>
                        <MenuItem Header="_Tools">
                            <MenuItem Header="_Recording setup..." Click="RecordingSetupMenuItem_Click"/>
                            <MenuItem Header="_Calibrate latency..." Click="CalibrateLatencyMenuItem_Click"/>
                            <Separator/>
                            <MenuItem Header="_Recordings folder size..." Click="RecordingsFolderSizeMenuItem_Click"/>
                        </MenuItem>
                        <MenuItem Header="_Help">
                            <MenuItem Header="_About" Click="AboutMenuItem_Click"/>
                        </MenuItem>
                    </Menu>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="ProjectTitleText" FontFamily="{StaticResource PlexSansMedium}" FontSize="13" Foreground="{StaticResource TextBrush}"
                               MaxWidth="320" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="UndoButton" Content="↩" Click="UndoMenuItem_Click" Style="{StaticResource FlatIconButton}" Width="30" Height="30"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button x:Name="RedoButton" Content="↪" Click="RedoMenuItem_Click" Style="{StaticResource FlatIconButton}" Width="30" Height="30" Margin="0,0,10,0"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button x:Name="MinimizeButton" Content="🗕" Click="MinimizeButton_Click" Style="{StaticResource FlatIconButton}" Width="30" Height="30"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button x:Name="RestoreButton" Content="🗗" Click="RestoreButton_Click" Style="{StaticResource FlatIconButton}" Width="30" Height="30"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button x:Name="CloseButton" Content="✕" Click="CloseButton_Click" Style="{StaticResource FlatIconButton}" Width="30" Height="30"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== Transport bar ===================== -->
        <Border DockPanel.Dock="Top" Height="64" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
            <DockPanel Margin="16,0" LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="RestartButton" Content="⏮" Click="RestartButton_Click" Style="{StaticResource FlatIconButton}" Margin="0,0,4,0"/>
                    <Button x:Name="SeekBackButton" Content="−5s" Click="SeekBackButton_Click" Style="{StaticResource FlatIconButton}" Width="44" Margin="0,0,8,0"/>
                    <Button x:Name="PlayButton" Content="▶" Click="PlayButton_Click" Style="{StaticResource TransportCircleButton}" FontSize="18" Margin="0,0,8,0"/>
                    <Button x:Name="SeekForwardButton" Content="+5s" Click="SeekForwardButton_Click" Style="{StaticResource FlatIconButton}" Width="44" Margin="0,0,10,0"/>
                    <Button x:Name="RecordButton" Click="RecordButton_Click" Style="{StaticResource RecordButtonStyle}" Padding="12,8" Margin="0,0,16,0">
                        <TextBlock x:Name="RecordButtonText" Text="● Record layer 1"/>
                    </Button>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="CurrentTimeText" Text="0:00.0" FontFamily="{StaticResource PlexMonoRegular}" FontSize="13" Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text=" / " FontFamily="{StaticResource PlexMonoRegular}" FontSize="13" Foreground="{StaticResource MutedTextBrush}"/>
                        <TextBlock x:Name="TotalDurationText" Text="0:00.0" FontFamily="{StaticResource PlexMonoRegular}" FontSize="13" Foreground="{StaticResource MutedTextBrush}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="10,4" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="BPM" FontSize="11" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="MetronomeBpmTextBox" Text="130.000" Width="54" Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"
                                     LostFocus="MetronomeBpmTextBox_LostFocus" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                            <ComboBox x:Name="TimeSignatureCombo" Width="58" Margin="8,0,0,0" VerticalAlignment="Center"
                                      SelectionChanged="TimeSignatureCombo_SelectionChanged" ToolTip="Metronome time signature. The first beat of each bar is accented."
                                      shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                        </StackPanel>
                    </Border>

                    <ToggleButton x:Name="MonitorToggle" Content="Monitor" Style="{StaticResource TogglePillButton}" IsChecked="True"
                                  Checked="MonitorToggle_Changed" Unchecked="MonitorToggle_Changed" Margin="0,0,16,0"
                                  shell:WindowChrome.IsHitTestVisibleInChrome="True"/>

                    <TextBlock Text="Master" FontSize="11" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ProgressBar x:Name="ToolbarPeakMeter" Minimum="0" Maximum="1" Value="0" Width="80" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <Slider x:Name="MasterVolumeSlider" Minimum="-60" Maximum="12" Value="0" Width="100" VerticalAlignment="Center"
                            ValueChanged="MasterVolumeSlider_ValueChanged" PreviewMouseUp="MasterVolumeSlider_PreviewMouseUp"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===================== Status bar ===================== -->
        <Border DockPanel.Dock="Bottom" Height="28" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="12,0">
            <DockPanel LastChildFill="True">
                <TextBlock x:Name="PerfText" DockPanel.Dock="Right" Text="CPU 0% · 0 MB" FontFamily="{StaticResource PlexMonoRegular}" FontSize="11"
                           Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
                <ProgressBar x:Name="ExportProgressBar" DockPanel.Dock="Right" Width="140" Height="12" Margin="8,0" Minimum="0" Maximum="1"
                             Visibility="Collapsed" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusText" FontSize="11" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"
                           Text="Space play / stop · ← → seek 5 s · Home back to start"/>
            </DockPanel>
        </Border>

        <!-- ===================== Body: preview+lanes | channel panel ===================== -->
        <Grid Background="{StaticResource GroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="400"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Margin="16">
                <!-- Preview: Viewbox lets the composited frame shrink to fit, always at the 16:9
                     export aspect ratio (PreviewCanvasAspectRatioTests). -->
                <Viewbox DockPanel.Dock="Top" Stretch="Uniform" StretchDirection="DownOnly" MaxHeight="405" Margin="0,0,0,12">
                    <Grid Width="640" Height="360">
                        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                            <skia:SKElement x:Name="CompositeCanvas" Width="640" Height="360" PaintSurface="CompositeCanvas_PaintSurface"/>
                        </Border>
                        <!-- Empty-cell overlay: the Engine already bakes a placeholder into the
                             composited bitmap for an audio-only layer, but a fully-empty slot
                             renders as plain black; this gives it the mock's "Layer N is empty"
                             affordance, reusing each row's own Record/Upload commands. -->
                        <ItemsControl x:Name="EmptyCellOverlay" IsHitTestVisible="True">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="2" Columns="2" Width="640" Height="360"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:LayerRowViewModel}">
                                    <Grid Background="#90131518" Visibility="{Binding HasSource, Converter={StaticResource InverseBoolToVis}}">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName, StringFormat='{}{0} is empty'}" Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Content="Record" Style="{StaticResource AccentButton}" Click="RecordChoice_Click" Padding="10,5" Margin="0,0,6,0"/>
                                                <Button Content="Upload" Click="UploadChoice_Click" Padding="10,5"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Viewbox>

                <!-- Lanes panel -->
                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8">
                    <DockPanel LastChildFill="True">
                        <Grid DockPanel.Dock="Top" Height="28" Background="{StaticResource RaisedBrush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="248"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="LaneHeaderCountText" Grid.Column="0" Text="Layers · 0 of 4" FontSize="11"
                                       Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            <!-- Song-position ruler: click/drag to seek (TimelineSliderClickToSeekTests). -->
                            <Slider x:Name="TimelineSlider" Grid.Column="1" Minimum="0" Maximum="1000" Value="0" VerticalAlignment="Center"
                                    IsMoveToPointEnabled="True"
                                    PreviewMouseDown="TimelineSlider_PreviewMouseDown"
                                    PreviewMouseUp="TimelineSlider_PreviewMouseUp"
                                    ValueChanged="TimelineSlider_ValueChanged"/>
                        </Grid>
                        <!-- Time-tick ruler (0:00, 0:30, 1:00 ... scaled to the project duration) plus
                             the song in/out markers, both drawn in code (RedrawRulerCanvas) since
                             their positions depend on the live timeline duration and track width. -->
                        <Grid DockPanel.Dock="Top" Height="20" Background="{StaticResource RaisedBrush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="248"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="SongRangeReadoutText" Grid.Column="0" FontSize="10"
                                       Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            <Canvas x:Name="RulerCanvas" Grid.Column="1" IsHitTestVisible="False" SizeChanged="RulerCanvas_SizeChanged"/>
                        </Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="TrackList" ItemTemplate="{StaticResource LaneRowTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Vertical"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </DockPanel>

            <!-- Channel panel: the selected layer's name/retake/delete header, Volume/Pan/Trim, and
                 its FX chain. -->
            <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0">
                <DockPanel x:Name="ChannelPanel" LastChildFill="True">
                    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="16,12">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right" x:Name="ChannelMoreButton" Content="⋯" Click="ChannelMoreButton_Click" Style="{StaticResource FlatIconButton}" Width="30" Height="30"/>
                            <Button DockPanel.Dock="Right" Content="↻" Click="RetakeButton_Click" Style="{StaticResource AccentButton}" Padding="10,5" Margin="0,0,6,0"/>
                            <!-- OneWay: FreezeToggle_Click must run its sync-state/close-editors work
                                 BEFORE Frozen flips, so this can't use the usual TwoWay+Click pattern
                                 (see the handler's doc comment). -->
                            <ToggleButton DockPanel.Dock="Right" Content="Freeze" Style="{StaticResource SegmentButton}"
                                          IsChecked="{Binding Frozen, Mode=OneWay}" Click="FreezeToggle_Click" Padding="10,5" Margin="0,0,6,0"/>
                            <Border DockPanel.Dock="Left" Width="10" Height="10" CornerRadius="2" Background="{Binding CellColor}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="FxHeaderText" Text="FX — Master" FontFamily="{StaticResource PlexSansSemiBold}" FontSize="14" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>

                    <Grid DockPanel.Dock="Top" Margin="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8" IsEnabled="{Binding IsNotFrozen}">
                            <TextBlock Text="Volume" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4"/>
                            <Slider Style="{StaticResource CommitSlider}" Minimum="-60" Maximum="12" Value="{Binding GainDb, Mode=TwoWay}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,8" IsEnabled="{Binding IsNotFrozen}">
                            <TextBlock Text="Pan" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4"/>
                            <Slider Style="{StaticResource CommitSlider}" Minimum="-1" Maximum="1" Value="{Binding Pan, Mode=TwoWay}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Trim in (ms)" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding TrimStartMs, Mode=TwoWay}" LostFocus="TrimTextBox_LostFocus"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,8">
                            <TextBlock Text="Trim out (ms)" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding TrimEndText, Mode=TwoWay}" LostFocus="TrimTextBox_LostFocus"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Picture" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4"/>
                            <CheckBox Content="Mirror" IsChecked="{Binding Mirror, Mode=TwoWay}" Click="CommitCheckBox_Click"
                                      ToolTip="Flip this layer's picture left-to-right."/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Timing nudge" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4"/>
                            <DockPanel LastChildFill="True">
                                <Button DockPanel.Dock="Left" Content="−" Click="NudgeEarlierButton_Click" Style="{StaticResource FlatIconButton}" Width="26" Height="24"
                                        ToolTip="Play this layer earlier (hold Shift for 1 ms steps, otherwise 10 ms)."/>
                                <Button DockPanel.Dock="Right" Content="+" Click="NudgeLaterButton_Click" Style="{StaticResource FlatIconButton}" Width="26" Height="24"
                                        ToolTip="Play this layer later (hold Shift for 1 ms steps, otherwise 10 ms)."/>
                                <TextBlock Text="{Binding ManualOffsetDisplay}" FontFamily="{StaticResource PlexMonoRegular}" FontSize="12"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand"
                                           MouseLeftButtonDown="NudgeLabel_MouseLeftButtonDown" ToolTip="Click to reset to 0."/>
                            </DockPanel>
                        </StackPanel>
                    </Grid>

                    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="16,10,16,4">
                        <StackPanel>
                            <TextBlock Text="Effects" FontFamily="{StaticResource PlexSansSemiBold}" FontSize="13"/>
                            <TextBlock Text="Signal flows top to bottom" FontSize="11" Foreground="{StaticResource MutedTextBrush}"/>
                        </StackPanel>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <!-- Scoped to just these six rows (MixingScreenTests.FxPanel_HasNoSliderBoundToGainDb):
                             the Volume slider above (bound to GainDb) must stay outside this element. -->
                        <StackPanel x:Name="FxPanel" Margin="16,8" IsEnabled="{Binding IsNotFrozen}">
                            <Border Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,8" Padding="12">
                                <DockPanel LastChildFill="True">
                                    <ToggleButton DockPanel.Dock="Left" Style="{StaticResource FxPowerToggle}" IsChecked="{Binding NoiseGateEnabled, Mode=TwoWay}" Click="CommitCheckBox_Click" Margin="0,0,10,0"/>
                                    <Button DockPanel.Dock="Right" Content="Open" Click="OpenNoiseGateEditor_Click" Style="{StaticResource AccentButton}" Padding="8,4"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Noise gate" FontFamily="{StaticResource PlexSansMedium}"/>
                                        <TextBlock Text="FabFilter Pro-G" FontSize="11" Foreground="{StaticResource MutedTextBrush}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <Border Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,8" Padding="12">
                                <DockPanel LastChildFill="True">
                                    <ToggleButton DockPanel.Dock="Left" Style="{StaticResource FxPowerToggle}" IsChecked="{Binding CompressorEnabled, Mode=TwoWay}" Click="CommitCheckBox_Click" Margin="0,0,10,0"/>
                                    <Button DockPanel.Dock="Right" Content="Open" Click="OpenCompressorEditor_Click" Style="{StaticResource AccentButton}" Padding="8,4"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Compressor" FontFamily="{StaticResource PlexSansMedium}"/>
                                        <TextBlock Text="FabFilter Pro-C 3" FontSize="11" Foreground="{StaticResource MutedTextBrush}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <Border Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,8" Padding="12">
                                <DockPanel LastChildFill="True">
                                    <ToggleButton DockPanel.Dock="Left" Style="{StaticResource FxPowerToggle}" IsChecked="{Binding EqEnabled, Mode=TwoWay}" Click="CommitCheckBox_Click" Margin="0,0,10,0"/>
                                    <Button DockPanel.Dock="Right" Content="Open" Click="OpenEqEditor_Click" Style="{StaticResource AccentButton}" Padding="8,4"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="EQ" FontFamily="{StaticResource PlexSansMedium}"/>
                                        <TextBlock Text="FabFilter Pro-Q 4" FontSize="11" Foreground="{StaticResource MutedTextBrush}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <Border Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,8" Padding="12">
                                <DockPanel LastChildFill="True">
                                    <ToggleButton DockPanel.Dock="Left" Style="{StaticResource FxPowerToggle}" IsChecked="{Binding ReverbEnabled, Mode=TwoWay}" IsEnabled="{Binding IsReverbHosted}" Click="CommitCheckBox_Click" Margin="0,0,10,0"/>
                                    <Button DockPanel.Dock="Right" Content="Open" Click="OpenReverbEditor_Click" Style="{StaticResource AccentButton}" Padding="8,4"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Reverb" FontFamily="{StaticResource PlexSansMedium}"/>
                                        <TextBlock Text="FabFilter Pro-R 2 · no native fallback" FontSize="11" Foreground="{StaticResource MutedTextBrush}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <Border Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,8" Padding="12">
                                <StackPanel>
                                    <DockPanel LastChildFill="True">
                                        <ToggleButton DockPanel.Dock="Left" Style="{StaticResource FxPowerToggle}" IsChecked="{Binding LimiterEnabled, Mode=TwoWay}" Click="CommitCheckBox_Click" Margin="0,0,10,0"/>
                                        <Button DockPanel.Dock="Right" Content="Open" Click="OpenLimiterEditor_Click" Style="{StaticResource AccentButton}" Padding="8,4"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Limiter" FontFamily="{StaticResource PlexSansMedium}"/>
                                            <TextBlock Text="Built-in · Pro-L 2 not installed" FontSize="11" Foreground="{StaticResource MutedTextBrush}"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <Grid Visibility="{Binding IsLimiterHosted, Converter={StaticResource InverseBoolToVis}}" Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Ceiling" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <Slider Grid.Row="0" Grid.Column="1" Minimum="-12" Maximum="0" Value="{Binding LimiterCeilingDb, Mode=TwoWay}" Style="{StaticResource CommitSlider}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Gain" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <Slider Grid.Row="1" Grid.Column="1" Minimum="-12" Maximum="24" Value="{Binding LimiterGainDb, Mode=TwoWay}" Style="{StaticResource CommitSlider}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                                <StackPanel>
                                    <DockPanel LastChildFill="True">
                                        <ToggleButton DockPanel.Dock="Left" Style="{StaticResource FxPowerToggle}" IsChecked="{Binding MelodyneEnabled, Mode=TwoWay}" Click="CommitCheckBox_Click" Margin="0,0,10,0"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Pitch correction" FontFamily="{StaticResource PlexSansMedium}" Cursor="Hand" MouseLeftButtonUp="EditMelodyne_Click"/>
                                            <TextBlock Text="Melodyne" FontSize="11" Foreground="{StaticResource MutedTextBrush}"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <ToggleButton Content="Melodyne" Style="{StaticResource SegmentButton}" Click="PitchModeMelodyne_Click"
                                                      IsChecked="{Binding PitchMode, Converter={StaticResource PitchModeEquals}, ConverterParameter=Melodyne, Mode=OneWay}"/>
                                        <ToggleButton Content="Auto" Style="{StaticResource SegmentButton}" Click="PitchModeAuto_Click"
                                                      IsChecked="{Binding PitchMode, Converter={StaticResource PitchModeEquals}, ConverterParameter=Auto, Mode=OneWay}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
