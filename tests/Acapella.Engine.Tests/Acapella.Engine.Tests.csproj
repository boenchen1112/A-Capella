<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="SkiaSharp" Version="4.150.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Acapella.Engine\Acapella.Engine.csproj" />
  </ItemGroup>

  <!-- v6 P3a task 0: the test host process needs AcapellaHostNative.dll alongside its own
       binaries to resolve the [DllImport] probe/hosting calls; see Acapella.App.csproj's
       matching target for why this is a separate build step (build.ps1), not part of dotnet build. -->
  <Target Name="CopyAcapellaHostNative" AfterTargets="Build">
    <ItemGroup>
      <AcapellaHostNativeDll Include="$(MSBuildThisFileDirectory)..\..\src\Acapella.Host.Native\build\bin\$(Configuration)\AcapellaHostNative.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(AcapellaHostNativeDll)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="Exists('%(AcapellaHostNativeDll.Identity)')" />
  </Target>

</Project>
